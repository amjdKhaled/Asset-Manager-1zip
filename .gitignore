# .NET build outputs
bin/
obj/
*.user
*.suo
.vs/
.vscode/
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
packages/
nuget.config.user

# The system-level /etc/.gitignore ignores .config/ but the dotnet local-tool
# manifest must be committed so any machine can run 'dotnet tool restore'.
!.config/dotnet-tools.json
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
wwwroot/lib/
**/Publish/
PublishOutput/

# Logs produced at runtime
logs/
*.log

# Runtime-written config (contains real server URLs; machine-specific)
src/LFPortal.Web/config/laserfiche.json

# Secrets — never commit
appsettings.Production.json
appsettings.Staging.json
*.pfx
*.p12
*.dpapi

# OS files
.DS_Store
Thumbs.db

# Replit internal (never gitignore these)
# .replit  ← must NOT be ignored
# replit.nix ← must NOT be ignored
