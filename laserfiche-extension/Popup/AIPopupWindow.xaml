<Window x:Class="LaserficheAIExtension.Popup.AIPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GovSearch AI Assistant"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBgLight" Color="#1a56db"/>
        <SolidColorBrush x:Key="HeaderBgDark" Color="#1e293b"/>
        <SolidColorBrush x:Key="BorderLight" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="BorderDark" Color="#374151"/>
        <SolidColorBrush x:Key="OverlayBg" Color="#f8fafc"/>
        <SolidColorBrush x:Key="OverlayDark" Color="#0f172a"/>
        <SolidColorBrush x:Key="TextLight" Color="#374151"/>
        <SolidColorBrush x:Key="TextDark" Color="#e2e8f0"/>
        <SolidColorBrush x:Key="SpinnerColor" Color="#1a56db"/>
        <Storyboard x:Key="SpinAnimation">
            <DoubleAnimation Storyboard.TargetName="Spinner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" BorderBrush="Transparent" BorderThickness="0"
            Margin="10"
            Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0"
                    Background="{StaticResource HeaderBgLight}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="GovSearch AI" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#22ffffff" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                            <TextBlock Text="AI Assistant" Foreground="White" FontSize="10" Opacity="0.9"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource WindowChromeButton}"
                                Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                Click="MinimizeButton_Click" ToolTip="Minimize"/>
                        <Button Style="{StaticResource WindowChromeButton}"
                                Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                Click="MaximizeButton_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource WindowChromeButton}"
                                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 Host -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="WebView" />

                <!-- Loading / Disconnected Overlay -->
                <Border x:Name="StatusOverlay" Background="{StaticResource OverlayBg}" Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Spinner -->
                            <Canvas Width="48" Height="48" HorizontalAlignment="Center">
                                <Path x:Name="Spinner"
                                      Data="M24,4 A20,20 0 1,1 4,24"
                                      Stroke="{StaticResource SpinnerColor}"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>

                            <TextBlock x:Name="StatusText"
                                       Text="Waiting for Local AI..."
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLight}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,4"/>

                            <TextBlock x:Name="StatusSubtext"
                                       Text="Checking http://localhost:5000"
                                       FontSize="12"
                                       Foreground="#6b7280"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="RetryText"
                                       Text="Retrying in 3 seconds..."
                                       FontSize="11"
                                       Foreground="#9ca3af"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#f3f4f6" CornerRadius="0,0,12,12">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#ef4444" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" FontSize="11" Foreground="#6b7280"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="DocumentStatusText"
                               Text="No document selected"
                               FontSize="11" Foreground="#9ca3af"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" x:Name="ServerUrlText"
                               Text="localhost:5000"
                               FontSize="11" Foreground="#9ca3af"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
