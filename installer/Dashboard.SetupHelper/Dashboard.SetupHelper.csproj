<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dashboard.SetupHelper.csproj
    Small net48 console EXE that performs elevated setup operations called by
    MSI custom actions via ExeCommand.

    WHY A SEPARATE EXE INSTEAD OF A DTF DLL?
    (Note: XML comments forbid double-hyphen sequences, so separator lines
    use equals signs instead of hyphens throughout this file.)

    WiX v4 DTF managed custom action DLLs require a native CLR-hosting shim
    (historically produced by MakeSfxCA.exe) that complicates cross-platform
    build pipelines and adds architecture constraints. An EXE called from an
    ExeCommand custom action avoids all of that:
      - No native shim required.
      - Full access to .NET Framework 4.8 BCL.
      - Testable standalone outside the installer.
      - Same architecture as the Desktop Extension (net48).

    HOW IT IS USED:
    The MSI harvests this EXE alongside the Desktop Extension files into
    EXTENSIONFOLDER. MSI custom actions call it with elevated privileges
    (Impersonate="no") from that directory.

    IMPORTANT: This project must NOT reference any NuGet packages that require
    a native DLL alongside the managed DLL. All functionality is provided by
    the .NET Framework 4.8 BCL (System.Xml.Linq, System.IO, Microsoft.Win32).

    BUILD: Windows only. Part of the build/publish.ps1 pipeline.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Dashboard.SetupHelper</AssemblyName>
    <RootNamespace>Dashboard.SetupHelper</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- x64 so the EXE can query 64-bit registry hives natively.
         The MSI runs in a 64-bit process on 64-bit Windows. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
