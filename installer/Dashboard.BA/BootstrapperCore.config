<?xml version="1.0" encoding="utf-8" ?>
<!--
  BootstrapperCore.config: WiX Burn managed BA host runtime configuration.

  PURPOSE:
    mbahost.dll (the WiX native managed-BA host embedded in the Burn bundle)
    reads this file at startup to know which CLR version to activate before
    loading Dashboard.BA.dll.

    WITHOUT THIS FILE mbahost.dll cannot identify a supported runtime, fails
    to activate any CLR, and Burn displays:
      "failed to load the .NET Framework runtime even though all of the
       prerequisites are installed."
    .NET 4.8 may be present on the machine, but the host has no instruction
    to use it — this config is the instruction.

  CONTENT NOTES:
    useLegacyV2RuntimeActivationPolicy="true"
      Required when the bundle includes assemblies (WixToolset.Mba.Core.dll)
      compiled for older CLR targets (net20).  Allows CLR 4 to load them.

    supportedRuntime version="v4.0"
      Requests CLR v4 (the shared runtime for .NET Framework 4.x).

    sku=".NETFramework,Version=v4.8"
      Specifies the minimum .NET Framework 4.8 profile.  Matches the
      TargetFramework in Dashboard.BA.csproj and the DetectCondition in
      Bundle.wxs (Release >= 528040).

  DEPLOYMENT:
    This file is copied to bin\Release\net48\ by the CopyToOutputDirectory
    entry in Dashboard.BA.csproj, then staged to artifacts\staging\BA\ by
    publish.ps1 Step 6, and embedded in LFDashboard-Setup.exe as a Bundle
    Payload by Bundle.wxs.

    The filename MUST remain "BootstrapperCore.config" — that is the exact
    filename mbahost.dll looks for.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
