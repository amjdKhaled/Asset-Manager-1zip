<?xml version="1.0" encoding="utf-8" ?>
<!--
  WixToolset.Mba.Host.config: WiX Burn 4.0.5 managed BA host runtime configuration.

  PURPOSE:
    mbahost.dll (the WiX native managed-BA host embedded in the Burn bundle)
    reads this file at startup to activate the correct CLR version before
    loading Dashboard.BA.dll.

    Burn 4.0.5 extracts this file to the .ba\ temporary directory alongside
    the other BootstrapperApplication payloads.  mbahost.dll looks for the
    file at exactly:

        .ba\WixToolset.Mba.Host.config

    WITHOUT THIS FILE Burn shows:
        "Error 0x8007006e: Failed to load bootstrapper config file from path:
         ...\.ba\WixToolset.Mba.Host.config"
        "Error 0x8007006e: Failed to find supported framework."
    and falls back to mbapreq.dll, which shows the native prereq failure
    screen — even when .NET 4.8 is fully installed on the machine.

  FILENAME NOTE:
    This file MUST be named WixToolset.Mba.Host.config.
    WiX 3 used BootstrapperCore.config; WiX 4.0.5 renamed it.
    Do not rename this file.

  CONTENT NOTES:
    useLegacyV2RuntimeActivationPolicy="true"
      Required because WixToolset.Mba.Core.dll was compiled for net20.
      This allows CLR 4 to load net20-targeted assemblies alongside net48
      assemblies in the same process without throwing a mixed-runtime error.

    supportedRuntime version="v4.0"
      Requests the CLR 4 shared runtime (the runtime for all .NET Framework
      4.x versions).

    sku=".NETFramework,Version=v4.8"
      Specifies .NET Framework 4.8 as the minimum required profile.
      Matches the TargetFramework in Dashboard.BA.csproj and the
      DetectCondition (NetFx48Release >= 528040) in Bundle.wxs.

  DEPLOYMENT:
    This file is copied to bin\Release\net48\ by the CopyToOutputDirectory
    entry in Dashboard.BA.csproj, then staged to artifacts\staging\BA\ by
    publish.ps1 Step 6 (via the wildcard Copy-Item), then embedded in
    LFDashboard-Setup.exe as a Bundle Payload by Bundle.wxs with explicit
    Name="WixToolset.Mba.Host.config" so the extracted filename inside the
    bundle is guaranteed correct.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
