<?xml version="1.0" encoding="utf-8" ?>
<!--
  WixToolset.Mba.Host.config: WiX Burn 4.0.5 managed BA host runtime configuration.

  PURPOSE:
    mbahost.dll (the WiX native managed-BA host embedded in the Burn bundle)
    reads this file at startup.  It serves two independent roles:

    ROLE 1 — CLR activation (<startup>)
      Tells mbahost.dll which CLR version to load into the process before any
      managed code runs.  Required because WixToolset.Mba.Core.dll targets
      net20 and mbahost.dll must be told to allow it alongside net48 code.

    ROLE 2 — BA assembly discovery (<wix.bootstrapper>)
      WixToolset.Mba.Host.dll (the managed factory-discovery helper auto-
      embedded by bal.wixext) reads:
          ConfigurationManager.GetSection("wix.bootstrapper/host")
      to obtain:
          assemblyName   — the short name of the DLL containing
                           [assembly: BootstrapperApplicationFactory(typeof(...))]
          supportedFrameworks — the CLR/SKU version list used internally by
                           WixToolset.Mba.Host.dll when selecting the runtime

      WITHOUT the <wix.bootstrapper> section, WixToolset.Mba.Host.dll cannot
      locate the BA assembly and returns E_NOTFOUND, which surfaces as:
          Error 0x80070490: Failed to create the managed bootstrapper application.
          Error 0x80070490: Failed to create the bootstrapper application.
          Error 0x80070490: Failed to create BA.
          Error 0x80070490: Failed to load BA.

  FILENAME:
    Burn 4.0.5 looks for this file at exactly:
        .ba\WixToolset.Mba.Host.config
    WiX 3 used BootstrapperCore.config; WiX 4.0.5 renamed it to match the
    managed-host assembly name.  Do not rename this file.

  CONFIGSECTIONS REGISTRATION:
    .NET's ConfigurationManager requires every custom section group and
    section to be declared in <configSections> with the fully-qualified
    type name of the class that parses it.  The types BootstrapperSectionGroup
    and HostSection are defined in WixToolset.Mba.Host.dll (the managed host
    helper that bal.wixext auto-embeds alongside mbahost.dll in the bundle).

  <startup> NOTES:
    useLegacyV2RuntimeActivationPolicy="true"
      Required because WixToolset.Mba.Core.dll was compiled for net20.
      This allows CLR 4 to load net20-targeted assemblies alongside net48
      assemblies in the same process without throwing a mixed-runtime error.

    supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"
      Requests CLR 4 (the runtime for all .NET Framework 4.x versions) and
      specifies .NET Framework 4.8 as the required profile.  Matches the
      TargetFramework in Dashboard.BA.csproj and the DetectCondition
      (NetFx48Release >= 528040) in Bundle.wxs.

  DEPLOYMENT:
    This file is copied to bin\Release\net48\ by the CopyToOutputDirectory
    entry in Dashboard.BA.csproj, staged to artifacts\staging\BA\ by
    publish.ps1 Step 6, then embedded in LFDashboard-Setup.exe as a Bundle
    Payload by Bundle.wxs with Name="WixToolset.Mba.Host.config".
-->
<configuration>

  <configSections>
    <sectionGroup name="wix.bootstrapper"
                  type="WixToolset.Mba.Host.BootstrapperSectionGroup, WixToolset.Mba.Host">
      <section name="host"
               type="WixToolset.Mba.Host.HostSection, WixToolset.Mba.Host" />
    </sectionGroup>
  </configSections>

  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    Tells WixToolset.Mba.Host.dll which assembly contains the BA factory.
    assemblyName must be the short assembly name WITHOUT the .dll extension.
    The managed host uses this to load the correct DLL from the .ba\ directory
    and call GetCustomAttributes<BootstrapperApplicationFactoryAttribute>() on it.

    supportedFrameworks lists the framework versions our BA supports.
    WixToolset.Mba.Host.dll reads this list internally when selecting the CLR
    runtime to activate.  Use the same SKU as the <supportedRuntime> above.
  -->
  <wix.bootstrapper>
    <host assemblyName="Dashboard.BA">
      <supportedFrameworks>
        <add version="v4.8" sku=".NETFramework,Version=v4.8" />
      </supportedFrameworks>
    </host>
  </wix.bootstrapper>

</configuration>
