<?xml version="1.0" encoding="utf-8" ?>
<!--
  WixToolset.Mba.Host.config
  ===========================================================================
  Read by native mbahost.dll at bundle startup.  mbahost.dll uses TWO
  distinct sections in this file for two different purposes:

  1. <startup>  (read by the native CLR activation layer)
     Tells mbahost which CLR version to activate before loading any managed
     code.  'version="v4.0"' selects the .NET Framework 4.x CLR (CLR 4).
     'sku=".NETFramework,Version=v4.8"' is a hint to the CLR that .NET 4.8
     class libraries are expected; this causes the runtime to set the correct
     compatibility switches.
     'useLegacyV2RuntimeActivationPolicy="true"' is required for WiX managed
     BAs — it tells the CLR to load unmanaged assemblies (mbahost.dll) in the
     same appdomain as the managed code rather than a separate activation
     context.

  2. <wix.bootstrapper> (read by managed WixToolset.Mba.Host.dll via
     ConfigurationManager.GetSection("wix.bootstrapper/host"))
     Tells the managed Burn host which assembly contains the
     [assembly: BootstrapperApplicationFactory(...)] attribute.
     assemblyName: the simple assembly name (NOT a filename; no ".dll").
       Assembly.Load(assemblyName) probes the .ba\ extraction directory.

  SCHEMA NOTES (verified against WixToolset.Mba.Host 4.0.5 DLL metadata):
  =========================================================================
  HostSection has exactly one ConfigurationProperty: assemblyName (required).
  SupportedFrameworkElement has exactly one ConfigurationProperty: version.
    - 'sku' is NOT a recognised attribute in SupportedFrameworkElement and
      MUST NOT be included.  ConfigurationElement throws
      ConfigurationErrorsException (HRESULT 0x80131902) on any unrecognised
      XML attribute — this was the confirmed root cause of the startup failure.
    - version uses the CLR version string format ("v4.0"), NOT the framework
      marketing version ("v4.8").  For .NET Framework 4.x the CLR version is
      always "v4.0".
  <supportedFrameworks> is optional.  Omitting it skips the runtime-version
  validation check inside WixToolset.Mba.Host.dll; mbahost.dll's <startup>
  element already enforces the CLR version independently.

  FILE NAME CONTRACT:
    The filename must remain "WixToolset.Mba.Host.config".
    Burn 4.x looks for it at exactly .ba\WixToolset.Mba.Host.config.
    Any other name → 0x8007006e (Failed to load bootstrapper config file).
    This is a WiX 4 rename from WiX 3's "BootstrapperCore.config".
-->
<configuration>

  <configSections>
    <sectionGroup name="wix.bootstrapper"
                  type="WixToolset.Mba.Host.BootstrapperSectionGroup, WixToolset.Mba.Host">
      <section name="host"
               type="WixToolset.Mba.Host.HostSection, WixToolset.Mba.Host" />
    </sectionGroup>
  </configSections>

  <!--
    CLR activation — used by the NATIVE mbahost.dll before any managed code loads.
    version="v4.0"  : activates CLR 4 (covers all .NET Framework 4.x versions).
    sku             : signals .NET 4.8 so the CLR enables 4.8 compatibility flags.
  -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    Managed BA assembly name — used by WixToolset.Mba.Host.dll (managed) via
    ConfigurationManager.GetSection("wix.bootstrapper/host").

    assemblyName: simple name only, no ".dll" extension, no path.
      Assembly.Load("Dashboard.BA") probes .ba\Dashboard.BA.dll in the
      extraction AppBase that mbahost.dll sets up.

    <supportedFrameworks> is intentionally omitted.
      Including it with an incorrect 'sku' attribute (not defined by
      SupportedFrameworkElement) caused ConfigurationErrorsException 0x80131902.
      The <startup> element above already pins the CLR version; the optional
      WiX framework validation is not needed.
  -->
  <wix.bootstrapper>
    <host assemblyName="Dashboard.BA" />
  </wix.bootstrapper>

</configuration>
