<Project Sdk="WixToolset.Wix/4.0.5">

  <!--
    Dashboard.Installer.wixproj: WiX v4 MSI installer for the Dashboard suite.

    BUILD REQUIREMENTS (Windows only):
      1. .NET 8 SDK
      2. WiX v4 global tool:      dotnet tool install -global wix
      3. WiX extensions:
           wix extension add WixToolset.UI.wixext/4.0.5
           wix extension add WixToolset.Iis.wixext/4.0.3
           wix extension add WixToolset.Util.wixext/4.0.5
      4. Staged artifacts from build\publish.ps1:
           artifacts\staging\WebApp\         (dotnet publish output)
           artifacts\staging\Extension\      (Desktop Extension Release output)
           artifacts\staging\ConfigTemplate\ (config template JSON files)

    OUTPUT:
      artifacts\Dashboard-$(ProductVersion)-Setup.msi

    USAGE (recommended via build script):
      .\build\publish.ps1

    Direct build after staging:
      dotnet build installer\Dashboard.Installer\Dashboard.Installer.wixproj
      dotnet build ... -p:ProductVersion=1.2.3
      dotnet build ... -p:DashboardPort=80

    Do NOT build this project on Linux. WiX MSI output requires Windows.
  -->

  <PropertyGroup>
    <OutputName>Dashboard-$(ProductVersion)-Setup</OutputName>
    <OutputType>Package</OutputType>
    <OutputPath>..\..\artifacts\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Build-time property overrides -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DashboardPort   Condition="'$(DashboardPort)'   == ''">5000</DashboardPort>
  </PropertyGroup>

  <!--
    Staging directory paths.
    installer\Dashboard.Installer\..\..\  resolves to the repository root.
    Each property is declared separately to avoid whitespace in values.
  -->
  <PropertyGroup>
    <WebAppStagingDir>$(MSBuildThisFileDirectory)..\..\artifacts\staging\WebApp</WebAppStagingDir>
    <ExtStagingDir>$(MSBuildThisFileDirectory)..\..\artifacts\staging\Extension</ExtStagingDir>
    <CfgTemplateStagingDir>$(MSBuildThisFileDirectory)..\..\artifacts\staging\ConfigTemplate</CfgTemplateStagingDir>
  </PropertyGroup>

  <!--
    WiX preprocessor variables.
    Each assignment appends to the previous value with a semicolon separator.
    Keeping each on its own line avoids leading/trailing whitespace in values.
  -->
  <PropertyGroup>
    <DefineConstants>PublishDir=$(WebAppStagingDir)</DefineConstants>
    <DefineConstants>$(DefineConstants);ExtensionDir=$(ExtStagingDir)</DefineConstants>
    <DefineConstants>$(DefineConstants);ConfigTemplateDir=$(CfgTemplateStagingDir)</DefineConstants>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion)</DefineConstants>
    <DefineConstants>$(DefineConstants);DashboardPort=$(DashboardPort)</DefineConstants>
  </PropertyGroup>

  <!-- WiX extensions -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext"   Version="4.0.5" />
    <PackageReference Include="WixToolset.Iis.wixext"  Version="4.0.3" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.5" />
  </ItemGroup>

  <!-- WiX source files -->
  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="WebApplication.wxs" />
    <Compile Include="DesktopExtension.wxs" />
    <Compile Include="Configuration.wxs" />
    <Compile Include="Shortcuts.wxs" />
  </ItemGroup>

  <!--
    File harvesting.
    HarvestDirectory generates a ComponentGroup for every file in the directory
    tree.  The generated groups are referenced by name in Product.wxs features.

    WebAppComponents    all files from the dotnet publish output
    ExtensionComponents all files from the Desktop Extension build output

    SuppressRootDirectory="true" places files directly into DirectoryRefId
    without creating an extra component for the staging folder itself.
  -->
  <ItemGroup>
    <HarvestDirectory Include="$(WebAppStagingDir)">
      <ComponentGroupName>WebAppComponents</ComponentGroupName>
      <DirectoryRefId>WEBAPPFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>

    <HarvestDirectory Include="$(ExtStagingDir)">
      <ComponentGroupName>ExtensionComponents</ComponentGroupName>
      <DirectoryRefId>EXTENSIONFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

  <!-- Embedded resources (UI bitmaps, licence) -->
  <!--
    Replace License.rtf, Banner.bmp, Dialog.bmp with branded versions for
    a production release.  Placeholder files are provided in this directory.
  -->
  <ItemGroup>
    <EmbeddedResource Include="License.rtf" />
    <EmbeddedResource Include="Banner.bmp"  Condition="Exists('Banner.bmp')" />
    <EmbeddedResource Include="Dialog.bmp"  Condition="Exists('Dialog.bmp')" />
  </ItemGroup>

</Project>
