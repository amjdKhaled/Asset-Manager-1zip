<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration.wxs: ProgramData configuration files.

  Live config files are created by Dashboard.SetupHelper, not owned as MSI File
  resources. This is the standard Windows Installer pattern for mutable user
  data: repair and upgrade preserve it, normal uninstall leaves it available
  for a reinstall, and the bundle's explicit cleanup option can remove it.

  The ConfigTemplate\ sub-directory is a separate component WITHOUT these
  attributes: it IS overwritten on upgrade so administrators always have the
  current schema reference, even when their live files are protected.

  Paths established here (matching the application source code):
    %ProgramData%\Dashboard\extension.config.json   (Desktop Extension config)
    %ProgramData%\Dashboard\laserfiche.config.json  (Web app connection config)

  Credentials are never stored in configuration files packaged in the MSI.
  The administrator enters them via the Dashboard Settings page which encrypts
  them with Windows DPAPI into %ProgramData%\Dashboard\credentials\.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>

    <!-- Schedules the util:QueryWindowsWellKnownSIDs custom action, which sets
         WIX_ACCOUNT_NETWORKSERVICE (and friends) to the LOCALIZED well-known
         account name resolved from its SID (S-1-5-20).  Required for the
         SID-based PermissionEx entries below to work on non-English Windows. -->
    <util:QueryWindowsWellKnownSIDs />

    <!-- Sub-directories under %ProgramData%\Dashboard\ -->
    <DirectoryRef Id="PROGRAMDATAFOLDER">
      <Directory Id="CREDSFOLDER"      Name="credentials" />
      <Directory Id="CONFIGLOGSFOLDER" Name="logs" />
      <Directory Id="CONFIGTMPLFOLDER" Name="ConfigTemplate" />
    </DirectoryRef>

    <!-- Configuration files and directories -->
    <ComponentGroup Id="ConfigComponents">

      <!--
        %ProgramData%\Dashboard\ root directory.
        The web app writes Settings-page overrides to laserfiche.runtime.json
        directly in this directory, so the app pool identity needs write access
        here — not only in the credentials\ and logs\ sub-directories.
        SID-based account resolution (see CompCredsDir) keeps this working on
        non-English Windows.
      -->
      <Component Id="CompDashboardDataDir"
                 Directory="PROGRAMDATAFOLDER"
                 Guid="{C0D1E2F3-A4B5-4678-2345-901234567890}">
        <CreateFolder>
          <util:PermissionEx
            User="[WIX_ACCOUNT_NETWORKSERVICE]"
            GenericAll="yes" />
        </CreateFolder>
      </Component>

      <!--
        credentials\ directory.
        Created with write permissions for the IIS App Pool identity so
        the Dashboard web app can write DPAPI-encrypted credential files.
      -->
      <Component Id="CompCredsDir"
                 Directory="CREDSFOLDER"
                 Guid="{F7A8B9C0-D1E2-4345-F012-678901234567}">
        <CreateFolder>
          <!-- SID-based account resolution: WIX_ACCOUNT_LOCALSERVICE etc. are
               populated by util:QueryWindowsWellKnownSIDs with the LOCALIZED
               account name, so this works on non-English Windows where the
               literal "NETWORK SERVICE" account name does not exist. -->
          <util:PermissionEx
            User="[WIX_ACCOUNT_NETWORKSERVICE]"
            GenericAll="yes" />
        </CreateFolder>
      </Component>

      <!--
        logs\ directory.
        Created with write permissions for IIS App Pool identity (web app logs)
        and for the extension process (extension.log).
      -->
      <Component Id="CompLogsDir"
                 Directory="CONFIGLOGSFOLDER"
                 Guid="{A8B9C0D1-E2F3-4456-0123-789012345678}">
        <CreateFolder>
          <!-- SID-based resolution — see CompCredsDir comment. -->
          <util:PermissionEx
            User="[WIX_ACCOUNT_NETWORKSERVICE]"
            GenericAll="yes" />
        </CreateFolder>
      </Component>

      <!--
        ConfigTemplate\ directory: reference copies of the latest config schema.
        These ARE overwritten on upgrade (no NeverOverwrite/Permanent) so
        administrators always have the current schema available, even if their
        live files in PROGRAMDATAFOLDER are protected and contain older fields.
      -->
      <Component Id="CompConfigTemplates"
                 Directory="CONFIGTMPLFOLDER"
                 Guid="{B9C0D1E2-F3A4-4567-1234-890123456789}">
        <File Id="FileTmplExtension"
              Name="extension.config.json"
              Source="$(var.ConfigTemplateDir)\extension.config.json" />
        <File Id="FileTmplLaserfiche"
              Name="laserfiche.config.json"
              Source="$(var.ConfigTemplateDir)\laserfiche.config.json" />
      </Component>

    </ComponentGroup>

  </Fragment>
</Wix>
