<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration.wxs — ProgramData configuration files.

  All configuration files use NeverOverwrite="yes" so they are created on
  first install and NEVER touched by subsequent upgrades or repairs.
  Administrator-edited values are always preserved.

  Paths established here (matching the application code):
    %ProgramData%\Dashboard\extension.config.json   — Desktop Extension config
    %ProgramData%\Dashboard\laserfiche.config.json  — Web app Laserfiche connection

  Template files (always updated on upgrade so admins see the latest schema):
    [WEBAPPFOLDER]\ConfigTemplate\laserfiche.config.json
    [WEBAPPFOLDER]\ConfigTemplate\extension.config.json

  Credentials are NEVER stored in configuration files packaged in the MSI.
  The administrator enters them via the Dashboard Settings page (POST /Settings/Save)
  which encrypts them with Windows DPAPI into %ProgramData%\Dashboard\credentials\.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>

    <!-- ── Sub-directories under %ProgramData%\Dashboard\ ─────────────── -->
    <DirectoryRef Id="PROGRAMDATAFOLDER">
      <Directory Id="CREDSFOLDER"     Name="credentials" />
      <Directory Id="CONFIGLOGSFOLDER" Name="logs" />
      <Directory Id="CONFIGTMPLFOLDER" Name="ConfigTemplate" />
    </DirectoryRef>

    <!-- ── Configuration files (NeverOverwrite) ───────────────────────── -->
    <ComponentGroup Id="ConfigComponents">

      <!--
        Extension config — read by Dashboard.DesktopExtension.exe at runtime.
        Edit portalUrl to point to the Dashboard server.
        NeverOverwrite: administrator changes survive any upgrade.
      -->
      <Component Id="CompExtensionConfig"
                 Directory="PROGRAMDATAFOLDER"
                 Guid="{D5E6F7A8-B9C0-4123-DEF0-456789012345}">
        <File Id="FileExtensionConfig"
              Name="extension.config.json"
              Source="$(var.ConfigTemplateDir)\extension.config.json"
              NeverOverwrite="yes"
              Vital="no" />
      </Component>

      <!--
        Web app Laserfiche connection configuration — read by appsettings.json
        override at runtime (if the app is configured to look for it in ProgramData).
        Edit ServerUrl, RepositoryId, and DisplayName after installation.
        NeverOverwrite: administrator changes survive any upgrade.

        Note: if your deployment uses a writable config override file, place it
        here. The default installation reads appsettings.json from the web app
        directory. To use this file, configure the app host to load it as an
        additional JSON config source.
      -->
      <Component Id="CompLaserficheConfig"
                 Directory="PROGRAMDATAFOLDER"
                 Guid="{E6F7A8B9-C0D1-4234-EF01-567890123456}">
        <File Id="FileLaserficheConfig"
              Name="laserfiche.config.json"
              Source="$(var.ConfigTemplateDir)\laserfiche.config.json"
              NeverOverwrite="yes"
              Vital="no" />
      </Component>

      <!--
        credentials\ directory — created here so IIS / the app can write to it.
        DPAPI-encrypted credential files are written by the Settings page at runtime.
        This component creates the directory with appropriate ACLs.
      -->
      <Component Id="CompCredsDir"
                 Directory="CREDSFOLDER"
                 Guid="{F7A8B9C0-D1E2-4345-F012-678901234567}">
        <CreateFolder>
          <!--
            Grant IIS Network Service full control so the web app can write
            DPAPI-encrypted credential files into this directory.
          -->
          <util:PermissionEx xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
            User="NETWORK SERVICE"
            Domain="[%%COMPUTERNAME]"
            GenericAll="yes" />
        </CreateFolder>
      </Component>

      <!--
        logs\ directory — created with write access for IIS / the extension.
      -->
      <Component Id="CompLogsDir"
                 Directory="CONFIGLOGSFOLDER"
                 Guid="{A8B9C0D1-E2F3-4456-0123-789012345678}">
        <CreateFolder>
          <util:PermissionEx xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
            User="NETWORK SERVICE"
            Domain="[%%COMPUTERNAME]"
            GenericAll="yes" />
        </CreateFolder>
      </Component>

      <!--
        Template files — ALWAYS overwritten on upgrade so admins can see the
        latest config schema.  These are reference copies only; the live files
        are the NeverOverwrite ones above.
      -->
      <Component Id="CompConfigTemplates"
                 Directory="CONFIGTMPLFOLDER"
                 Guid="{B9C0D1E2-F3A4-4567-1234-890123456789}">
        <File Id="FileTmplExtension"
              Name="extension.config.json"
              Source="$(var.ConfigTemplateDir)\extension.config.json" />
        <File Id="FileTmplLaserfiche"
              Name="laserfiche.config.json"
              Source="$(var.ConfigTemplateDir)\laserfiche.config.json" />
      </Component>

      <!--
        appsettings.json in the web app folder — treated as a template reference.
        The shipping appsettings.json contains only placeholder values (no credentials).
        It is versioned with the app and SHOULD be updated on upgrade.
        Credentials are stored in %ProgramData%\Dashboard\credentials\ via DPAPI.
      -->
      <Component Id="CompAppSettings"
                 Directory="WEBAPPFOLDER"
                 Guid="{C0D1E2F3-A4B5-4678-2345-901234567890}">
        <File Id="FileAppSettings"
              Name="appsettings.json"
              Source="$(var.PublishDir)\appsettings.json" />
      </Component>

    </ComponentGroup>

  </Fragment>
</Wix>
