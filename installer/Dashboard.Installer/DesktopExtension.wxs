<?xml version="1.0" encoding="utf-8"?>
<!--
  DesktopExtension.wxs: Desktop Extension component group declaration.

  The extension FILES are harvested automatically from the build output by the
  HarvestDirectory item in Dashboard.Installer.wixproj.  The staging directory

      artifacts\staging\Extension\

  is mapped to ComponentGroup "ExtensionComponents" and placed in EXTENSIONFOLDER.

  The generated ComponentGroup is referenced from the FeatureExtension feature
  in Product.wxs.

  Extension registration (toolbar button) is handled by the RegisterExtension
  and UnregisterExtension custom actions in Product.wxs, which call:
      Dashboard.DesktopExtension.exe with the -setup -silent flags (on install/upgrade)
      Dashboard.DesktopExtension.exe with the -remove -silent flags (on uninstall)

  Note: the actual CLI flags use double-dash syntax: -setup, -remove, -silent
  (each prefixed with two hyphens at runtime). Single-dash notation is used in
  this XML comment because double-hyphen sequences are forbidden inside XML comments.

  Extension output (built on Windows, net48, x64):
    Dashboard.DesktopExtension.exe
    Newtonsoft.Json.dll
    Microsoft.Web.WebView2.WinForms.dll
    Microsoft.Web.WebView2.Core.dll
    runtimes\win-x64\native\WebView2Loader.dll
    Resources\Dashboard.ico

  NOTE: ClientAutomation.dll is NOT included in the MSI.
  It is provided by the Laserfiche Desktop Client installation and must be
  present on the machine before the setup flag is called.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- A real optional feature resource records Desktop registration choice.
         Helper/application payload remains in the required core feature. -->
    <ComponentGroup Id="DesktopIntegrationChoice">
      <Component Id="CompDesktopIntegrationChoice" Directory="EXTENSIONFOLDER"
                 Guid="{E3F1F55A-4773-4F51-AD40-27B6E65B98B0}">
        <RegistryValue Root="HKLM" Key="Software\Dashboard\Installer"
                       Name="DesktopIntegration" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

