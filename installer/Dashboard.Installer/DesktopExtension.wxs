<?xml version="1.0" encoding="utf-8"?>
<!--
  DesktopExtension.wxs — Files for the Dashboard Desktop Client Extension.

  Files are staged from:
    artifacts\staging\Extension\
  by build\publish.ps1.

  The extension EXE is registered with the Laserfiche Desktop Client toolbar
  via a WiX custom action (in Product.wxs) that calls:
    Dashboard.DesktopExtension.exe --setup --silent

  Extension output includes (net48, x64):
    Dashboard.DesktopExtension.exe
    Newtonsoft.Json.dll
    Microsoft.Web.WebView2.WinForms.dll
    Microsoft.Web.WebView2.Core.dll
    runtimes\win-x64\native\WebView2Loader.dll
    Resources\Dashboard.ico

  NOTE: ClientAutomation.dll is NOT included — it is provided by the
  Laserfiche Desktop Client installation and must be present on the machine.
  The extension locates it at runtime via the Laserfiche installation path.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include Variables.wxi ?>

  <Fragment>

    <ComponentGroup Id="ExtensionComponents" Directory="EXTENSIONFOLDER">

      <!-- All extension EXE + runtime DLL files from the staged output. -->
      <Files Include="$(var.ExtensionDir)\**\*.*" />

    </ComponentGroup>

  </Fragment>
</Wix>
