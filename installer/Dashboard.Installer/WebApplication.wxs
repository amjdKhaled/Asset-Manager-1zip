<?xml version="1.0" encoding="utf-8"?>
<!--
  WebApplication.wxs: IIS configuration for the Dashboard web application.

  The web application FILES are NOT listed here.  They are harvested
  automatically from the dotnet publish output by the HarvestDirectory item
  in Dashboard.Installer.wixproj.  The staging directory

      artifacts\staging\WebApp\

  is mapped to ComponentGroup "WebAppComponents" and placed in WEBAPPFOLDER.

  This file defines only the IIS infrastructure components (App Pool, Web Site).

  IIS configuration after install:
    Application Pool : Dashboard  (No Managed Code, Integrated pipeline)
    Web Site         : Dashboard, port $(DashboardPort) (default 5000)
    Physical path    : [WEBAPPFOLDER]
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:iis="http://wixtoolset.org/schemas/v4/wxs/iis">

  <?include Variables.wxi ?>

  <Fragment>

    <!-- IIS: Application Pool -->
    <!--
      ManagedRuntimeVersion="" = No Managed Code.
      Required for ASP.NET Core: the ANCM handles all request routing.
    -->
    <ComponentGroup Id="IisComponents" Directory="WEBAPPFOLDER">

      <Component Id="CompIisAppPool" Guid="{B3C4D5E6-F7A8-4901-BCDE-F23456789012}">
        <iis:WebAppPool
          Id="DashboardAppPool"
          Name="$(IisAppPoolName)"
          ManagedRuntimeVersion=""
          ManagedPipelineMode="Integrated"
          Identity="networkService" />
      </Component>

      <!--
        Web Site bound to port $(DashboardPort) (default 5000).
        Dashboard is the root application of this site.
        To use port 80 instead: rebuild the MSI with -p:DashboardPort=80.
        After installation the port can also be changed via IIS Manager.
      -->
      <Component Id="CompIisWebSite" Guid="{C4D5E6F7-A8B9-4012-CDEF-345678901234}">
        <CreateFolder />
        <iis:WebSite
          Id="DashboardWebSite"
          Description="$(IisSiteName)"
          Directory="WEBAPPFOLDER"
          AutoStart="yes"
          StartOnInstall="yes">
          <iis:WebAddress Id="DashboardWebAddress" Port="$(DashboardPort)" />
          <iis:WebApplication
            Id="DashboardWebApp"
            Name=""
            WebAppPool="DashboardAppPool" />
        </iis:WebSite>
      </Component>

    </ComponentGroup>

  </Fragment>
</Wix>
