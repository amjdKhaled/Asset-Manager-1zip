<?xml version="1.0" encoding="utf-8"?>
<!--
  WebApplication.wxs: IIS configuration for the Dashboard web application.

  The web application FILES are NOT listed here.  They are harvested
  automatically from the dotnet publish output by New-HarvestWxs in
  build\publish.ps1.  The staging directory

      artifacts\staging\WebApp\

  is mapped to ComponentGroup "WebAppComponents" and placed in WEBAPPFOLDER.

  This file defines only the IIS infrastructure components (App Pool, Web Site).

  IIS configuration after install:
    Application Pool : Dashboard  (No Managed Code, Integrated pipeline)
    Web Site         : Dashboard, port $(DashboardPort) (default 5000)
    Physical path    : [WEBAPPFOLDER]

  "No Managed Code" note:
    ManagedRuntimeVersion="" is the IIS setting for "No Managed Code", which is
    required for ASP.NET Core (ANCM handles all requests; no CLR should load).
    WiX 4 IIS extension rejects an empty-string ManagedRuntimeVersion attribute
    (WIX0006), so the attribute is omitted here.  The SetAppPoolNoManagedCode
    custom action in Product.wxs calls appcmd.exe after IIS creates the pool to
    set managedRuntimeVersion="" explicitly.

  WebApplication note:
    iis:WebApplication configures the root application ("/") of the site and
    assigns it to the Dashboard app pool.  Name="Dashboard" is the IIS internal
    label for this root application — it is not a virtual subdirectory path.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:iis="http://wixtoolset.org/schemas/v4/wxs/iis">

  <?include Variables.wxi ?>

  <Fragment>

    <!-- IIS: Application Pool -->
    <!--
      ManagedRuntimeVersion is intentionally omitted (WiX 4 rejects the empty
      string required for "No Managed Code").  SetAppPoolNoManagedCode in
      Product.wxs sets it correctly via appcmd after pool creation.
    -->
    <ComponentGroup Id="IisComponents" Directory="WEBAPPFOLDER">

      <Component Id="CompIisAppPool" Guid="{B3C4D5E6-F7A8-4901-BCDE-F23456789012}">
        <iis:WebAppPool
          Id="DashboardAppPool"
          Name="$(IisAppPoolName)"
          ManagedPipelineMode="Integrated"
          Identity="networkService" />
      </Component>

      <!--
        Web Site bound to port $(DashboardPort) (default 5000).
        Dashboard is the root application of this site.
        To use port 80 instead: rebuild the MSI with -d DashboardPort=80.
        After installation the port can also be changed via IIS Manager.
      -->
      <Component Id="CompIisWebSite" Guid="{C4D5E6F7-A8B9-4012-CDEF-345678901234}">
        <CreateFolder />
        <iis:WebSite
          Id="DashboardWebSite"
          Description="$(IisSiteName)"
          Directory="WEBAPPFOLDER"
          AutoStart="yes"
          StartOnInstall="yes">
          <iis:WebAddress Id="DashboardWebAddress" Port="$(DashboardPort)" />
          <!--
            WebApplication configures the root application ("/") of this site.
            Name="Dashboard" is the IIS internal identifier for the root app —
            it is a label, not a virtual path, and does not affect the URL.
            After install: http://<machine>:$(DashboardPort)/ serves Dashboard.
          -->
          <iis:WebApplication
            Id="DashboardWebApp"
            Name="Dashboard"
            WebAppPool="DashboardAppPool" />
        </iis:WebSite>
      </Component>

    </ComponentGroup>

  </Fragment>
</Wix>
