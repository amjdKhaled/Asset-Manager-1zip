<?xml version="1.0" encoding="utf-8"?>
<!--
  Product.wxs: Top-level package definition for the Dashboard installer.

  Defines the package identity, upgrade logic, features, UI, and custom actions.
  File content for WebApp and Extension is harvested by New-HarvestWxs in
  build\publish.ps1 (not via MSBuild HarvestDirectory; the build invokes
  the wix CLI directly, bypassing the wixproj MSBuild pipeline).

  Build:
    .\build\publish.ps1        (produces Release\LFDashboard-Setup.exe)

  Manual MSI-only rebuild: see publish.ps1 Step 8 for the exact wix build
  invocation with all -ext, -d, -b, and -out flags.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>

  <Package Name="Dashboard"
           Language="1033"
           Version="$(ProductVersion)"
           Manufacturer="Dashboard"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <!--
      MajorUpgrade: remove the old version before installing the new one.
      Configuration in %ProgramData%\Dashboard\ is preserved because those
      components use NeverOverwrite="yes" + Permanent="yes" in Configuration.wxs.
    -->
    <!--
      AllowSameVersionUpgrades="yes" (REGRESSION FIX):
        publish.ps1 builds every release as the same ProductVersion (1.0.0 by
        default) with an auto-generated ProductCode.  Without this flag,
        FindRelatedProducts does NOT treat a same-version rebuild as an upgrade,
        so a reinstall left the OLD MSI installed side-by-side.  Burn then
        uninstalled the old bundle AFTER the new chain completed; the old MSI's
        RemoveWebClient ran with its persisted LF_WEB_CLIENT_PATH and stripped
        the Dashboard button that the new install had just verified (1 -> 0).
        With this flag the new MSI removes the old MSI early (RemoveExistingProducts
        afterInstallInitialize, where LF_WEB_CLIENT_PATH is empty so the old
        RemoveWebClient is skipped); when Burn later uninstalls the old bundle the
        MSI package is already absent, so nothing strips the button.
    -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Dashboard is already installed. Downgrade is not supported. Please uninstall the current version first."
      Schedule="afterInstallInitialize" />

    <!--
      Prerequisite: ASP.NET Core Module V2 (ANCM) for IIS.

      Dashboard ships as a self-contained ASP.NET Core application — it carries
      its own copy of the .NET 8 runtime inside its install folder, so a globally
      installed .NET 8 runtime is NOT required.

      However IIS still needs the native ANCM V2 module (aspnetcorev2.dll) to
      host any ASP.NET Core application regardless of whether the deployment is
      self-contained or framework-dependent.  ANCM is installed by:
        - the ASP.NET Core Hosting Bundle (any version 6+)
        - the .NET SDK with IIS support
        - Visual Studio with the ASP.NET workload

      Detection: FileSearch for aspnetcorev2.dll in the well-known V2 path.
      ProgramFiles64Folder resolves to the 64-bit Program Files on x64 machines.
      If the file is present the property is set to its full path (non-empty =
      truthy); if absent the property remains unset and the Launch condition fires.

      NOTE: this check deliberately does NOT look for a globally installed .NET 8
      runtime.  The self-contained publish makes that unnecessary for Dashboard.
    -->
    <Property Id="ANCMV2PRESENT">
      <DirectorySearch Id="AncmV2DirSearch"
                       Path="[ProgramFiles64Folder]IIS\Asp.Net Core Module\V2">
        <FileSearch Id="AncmV2FileSearch" Name="aspnetcorev2.dll" />
      </DirectorySearch>
    </Property>

    <Launch
      Condition="ANCMV2PRESENT"
      Message="ASP.NET Core Module V2 (ANCM) for IIS is required but was not found.

Dashboard is self-contained and carries its own .NET runtime, but IIS still
needs ANCM to host it.  Install the ASP.NET Core Hosting Bundle (any version
6 or later), then re-run this installer.

Download: https://dotnet.microsoft.com/download/dotnet/8.0
Choose the &quot;Windows Hosting Bundle&quot; option." />

    <!-- Directory structure -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(InstallFolderName)">
        <Directory Id="WEBAPPFOLDER"    Name="WebApp" />
        <Directory Id="EXTENSIONFOLDER" Name="Extension" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATAFOLDER" Name="Dashboard">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="STARTMENUFOLDER" Name="$(StartMenuFolder)" />
    </StandardDirectory>

    <!-- Features -->
    <!--
      Feature tree:
        [Required] Dashboard Web Application (always installed)
          [Optional] Laserfiche Desktop Client Extension

      AllowAbsent="no" (WiX 4 — replaces WiX 3's Absent="disallow"): prevents
      the user from deselecting the core web-application feature in the setup UI.
    -->
    <Feature Id="FeatureWebApp"
             Title="Dashboard Web Application"
             Description="Installs the Dashboard ASP.NET Core web application and configures IIS."
             Level="1"
             AllowAbsent="no"
             AllowAdvertise="no"
             Display="expand">

      <ComponentGroupRef Id="WebAppComponents" />
      <ComponentGroupRef Id="IisComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />

      <Feature Id="FeatureExtension"
               Title="Laserfiche Desktop Client Extension"
               Description="Adds a Dashboard button to the Laserfiche Desktop Client toolbar. Requires the Laserfiche Desktop Client to be installed."
               Level="1"
               AllowAdvertise="no">
        <ComponentGroupRef Id="ExtensionComponents" />
      </Feature>

    </Feature>

    <!-- Installer UI -->
    <!--
      WixUI_FeatureTree: Welcome, License, Custom Setup, Install Dir, Install, Finish.
      Replace License.rtf with your organisation licence for production distribution.
    -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp"  Value="Banner.bmp"  Overridable="yes" />
    <WixVariable Id="WixUIDialogBmp"  Value="Dialog.bmp"  Overridable="yes" />

    <!--
      MSI Properties set by the Burn Bundle wizard (via MsiProperty in Bundle.wxs).
      When the MSI is run standalone (no Bundle), these are empty; the operator
      must supply them via the command line or run the Bundle instead.

      Secure="yes":
        Marks each property as a SecureCustomProperty.  This is required for
        properties that are passed from the Bundle via MsiProperty and then used
        inside ExeCommand attributes of *deferred* custom actions.  Without this,
        Windows Installer's elevated-context security filter can discard the values
        before the deferred actions run.

      Value attribute omitted (WiX 4 rejects Value=""):
        WiX 4 does not accept an empty string as a Property/@Value.  These
        properties are intentionally unset at package-definition time; their
        values are always supplied externally (Bundle or command line).
    -->
    <Property Id="DASHBOARD_URL"          Secure="yes" />
    <Property Id="LF_API_URL"             Secure="yes" />
    <!-- API version: Auto (probe v2 then v1 at runtime), v1, or v2.
         INTENTIONALLY NO DEFAULT: when the property is empty (direct-MSI
         repair / upgrade without the bundle UI), WriteConfig preserves the
         version already in laserfiche.config.json — a legacy "v1" pin is
         never silently rewritten to "Auto". Fresh installs with no existing
         file default to "Auto" inside WriteConfigAction. -->
    <Property Id="LF_API_VERSION"         Secure="yes" />
    <!-- LF_REPO_ID / LF_DISPLAY_NAME removed: repository is runtime session
         context, never installation configuration. -->
    <Property Id="LF_WEB_CLIENT_PATH"     Secure="yes" />
    <Property Id="INSTALL_DESKTOP_BUTTON" Value="1" />
    <Property Id="INSTALL_WEB_BUTTON"     Value="0" />
    <!--
      DASHBOARD_PORT: the TCP port selected by the wizard.
      INTENTIONALLY NO DEFAULT: when the property is empty (direct-MSI repair /
      upgrade without the bundle UI), WriteConfig reads the current port from
      appsettings.json and preserves it — a non-default port (e.g. 8080) is
      never silently reset to 5000.  Fresh installs with no existing
      appsettings.json default to 5000 inside WriteConfigAction.
      This mirrors exactly how LF_API_VERSION is handled.
      Secure="yes": required so the value is passed into the elevated deferred
      execution context where SetIisBindingPort and WriteConfig reference it via
      [DASHBOARD_PORT] in ExeCommand.
    -->
    <Property Id="DASHBOARD_PORT"         Secure="yes" />
    <!--
      TRUST_LF_CERT: operator consent (from the Bundle wizard checkbox) to
      trust a detected SELF-SIGNED Laserfiche API certificate on this machine.
      Consumed by the PrepareTls custom action. Consent only: the SetupHelper
      re-validates identity, validity, self-signed status, and chain state
      before touching LocalMachine\Root. Defaults to 0 (no trust change).
    -->
    <Property Id="TRUST_LF_CERT"          Value="0"    Secure="yes" />

    <!-- Custom actions: Desktop Extension registration -->
    <!--
      RegisterExtension: runs Dashboard.DesktopExtension.exe with the
      "setup" and "silent" CLI flags after files are installed.
      (Each flag is prefixed with two hyphens at runtime; double-hyphen
      sequences are forbidden inside XML comments so they are not written here.)
        Execute="deferred" + Impersonate="no": runs elevated so ClientAutomation
        SDK has write access to the Laserfiche toolbar registry.
        Return="ignore": if Laserfiche Desktop Client is not installed the EXE
        exits non-zero but the MSI install still succeeds.

      UnregisterExtension: runs with the "remove" and "silent" flags before
      files are removed. Scheduled Before="RemoveFiles" so the EXE is still
      on disk when it runs.
    -->
    <CustomAction Id="RegisterExtension"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.DesktopExtension.exe" --setup --silent'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterExtension"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.DesktopExtension.exe" --remove --silent'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Custom actions: SetupHelper EXE operations.

      WriteConfig:
        Writes extension.config.json and laserfiche.config.json to %ProgramData%\Dashboard\.
        Also patches "Urls" in [WEBAPPFOLDER]\appsettings.json so the ASP.NET Core
        app binds the wizard-selected port when started outside IIS.
        Must run AFTER InstallFiles (so Dashboard.SetupHelper.exe is on disk).
        Execute=deferred + Impersonate=no: elevated write access to %ProgramData%.
        Return=check: config is required; failure aborts installation cleanly.

      DeployWebClient:
        Copies lf-dashboard-button.js and patches Browse.aspx.
        Return=ignore: web client integration is optional; failure is non-fatal.
        Condition: only when INSTALL_WEB_BUTTON=1 and a path is provided.

      RollbackWebClient (rollback):
        Restores Browse.aspx from the most recent .bak file.
        Fires automatically if DeployWebClient ran and a later CA fails.
        Return=ignore: best-effort rollback.

      RemoveWebClient:
        Removes the Dashboard script tag from Browse.aspx on uninstall.
        Return=ignore: optional cleanup; if Browse.aspx was already removed, skip.

      SetAppPoolNoManagedCode:
        Calls appcmd.exe to set managedRuntimeVersion="" (No Managed Code) on
        the Dashboard app pool after the WiX IIS extension has created it.
        ManagedRuntimeVersion="" cannot be expressed as a WiX 4 IIS extension
        attribute (WIX0006 rejects the empty string), so an appcmd CA is used.
        "No Managed Code" is required for ASP.NET Core / ANCM: the CLR must not
        be loaded into the IIS worker process.
        Return=ignore: if appcmd is absent on a non-IIS machine the install still
        succeeds (ANCM on a proper IIS install will always have appcmd).

      SECURITY NOTE: LF_WEB_CLIENT_PATH comes from the wizard (no user input
      during install); it is persisted in the Bundle DB and re-used on uninstall.
      No passwords or credentials are passed to any SetupHelper command.
    -->

    <!--
      QUOTING NOTE (root cause of the 0x80070643 / Error 1722 failure):
      [WEBAPPFOLDER] expands WITH a trailing backslash.  Writing
      ...webapp-path "[WEBAPPFOLDER]" produced ..."C:\...\WebApp\" where the
      final \" is parsed by CommandLineToArgvW as an ESCAPED LITERAL QUOTE,
      so the helper received a path containing a '"' character and
      Path.Combine threw "Illegal characters in path" (exit 1 -> rollback).
      "[WEBAPPFOLDER]." appends a dot after the backslash so the closing
      quote is no longer escaped; the helper normalizes the trailing "\.".
    -->
    <CustomAction Id="WriteConfig"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --write-config --url "[DASHBOARD_URL]" --lf-api "[LF_API_URL]" --api-version "[LF_API_VERSION]" --port "[DASHBOARD_PORT]" --webapp-path "[WEBAPPFOLDER]."'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Return="check" (was "ignore"): DeployWebClient only runs when the user
      explicitly requested Web Client integration (INSTALL_WEB_BUTTON=1 AND
      LF_WEB_CLIENT_PATH<>"").  A requested deployment that fails verification
      must fail the install loudly instead of reporting success with no button.
    -->
    <!--
      PrepareTls: certificate/TLS preparation stage. Inspects the certificate
      presented by the Laserfiche API HTTPS endpoint, and (only for a valid
      self-signed certificate matching the host, with operator consent via
      TRUST_LF_CERT) installs the PUBLIC certificate into LocalMachine\Root,
      recycles the Dashboard app pool, and runs a full-validation HTTPS
      verification. Never bypasses TLS validation; never exports private keys.
      Runs BEFORE WriteConfig so trust exists before the configuration that
      the Dashboard will use is finalized and before its first API request.
      Return="ignore": trust preparation is best-effort; every outcome is
      logged to SetupHelper.log with the [TLS SETUP] prefix. A missing or
      unreachable API must never roll back the whole installation.
    -->
    <CustomAction Id="PrepareTls"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --prepare-tls --lf-api "[LF_API_URL]" --trust-selfsigned "[TRUST_LF_CERT]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="DeployWebClient"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --deploy-webclient --url "[DASHBOARD_URL]" --path "[LF_WEB_CLIENT_PATH]."'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RollbackWebClient"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --rollback-webclient --path "[LF_WEB_CLIENT_PATH]."'
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveWebClient"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --remove-webclient --path "[LF_WEB_CLIENT_PATH]."'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      SetAppPoolNoManagedCode: sets managedRuntimeVersion="" (No Managed Code)
      on the Dashboard app pool via appcmd.exe.  This is required for ASP.NET
      Core / ANCM — the CLR must not be loaded into the IIS worker process.
      WiX 4's IIS extension rejects an empty-string ManagedRuntimeVersion
      attribute (WIX0006), so appcmd is used as a post-creation fixup.

      SetIisBindingPort: overwrites the IIS site binding with the wizard-
      selected port ([DASHBOARD_PORT]).  This is necessary because the
      iis:WebAddress Port attribute is typed as an integer in the WiX schema —
      it accepts only a compile-time value ("$(DashboardPort)" = 5000).  The
      runtime MSI property [DASHBOARD_PORT] cannot be used in that attribute.
      appcmd sets the final binding to match whatever port the wizard chose.
      The binding format is  http/*:PORT:  (all IPs, specified port, no SNI).

      Both actions run Before="InstallFinalize":
        - WiX 4's IIS extension does NOT export ConfigureIIs as a public
          WixAction symbol; After="ConfigureIIs" causes linker error WIX0094.
        - All WiX IIS extension work (ConfigureIIs) is scheduled at sequence
          position ~3700, well before InstallFinalize (~6600), so the app pool
          and web site are fully created before either appcmd call runs.
        - Return="ignore": if appcmd is missing (non-IIS machine) or fails,
          installation still succeeds.  On any proper IIS install, appcmd.exe
          is always present in [SystemFolder]inetsrv\.
    -->
    <CustomAction Id="SetAppPoolNoManagedCode"
                  Directory="WEBAPPFOLDER"
                  ExeCommand='"[SystemFolder]inetsrv\appcmd.exe" set apppool "$(IisAppPoolName)" /managedRuntimeVersion:""'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="SetIisBindingPort"
                  Directory="WEBAPPFOLDER"
                  ExeCommand='"[SystemFolder]inetsrv\appcmd.exe" set site "$(IisSiteName)" /bindings:"http/*:[DASHBOARD_PORT]:"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Install execute sequence.

      On install / upgrade (NOT REMOVE~="ALL"):
        InstallFiles              (MSI built-in: copies all harvested files)
        ConfigureIIs              (WiX IIS ext: creates app pool and web site)
        SetAppPoolNoManagedCode   (appcmd: sets managedRuntimeVersion="" on pool)
        WriteConfig               (writes %ProgramData%\Dashboard\ config files)
        RegisterExtension         (registers the Desktop Client toolbar button)
        RollbackWebClient         (rollback CA: restores Browse.aspx if later step fails)
        DeployWebClient           (patches Browse.aspx; conditioned on wizard choice)

      On uninstall (REMOVE~="ALL"):
        RemoveWebClient           (strips Dashboard tag from Browse.aspx)
        UnregisterExtension       (removes toolbar button registration)
        RemoveFiles               (MSI built-in: deletes installed files)

      WiX 4 change: conditions are a Condition="..." attribute on <Custom>;
      inner text is no longer valid (WIX0400).  Double-quotes inside the
      condition string are encoded as &quot; since the attribute is delimited
      by double-quotes.
    -->
    <InstallExecuteSequence>
      <!--
        SetAppPoolNoManagedCode + SetIisBindingPort both run Before="InstallFinalize".

        WHY NOT After="ConfigureIIs":
          In WiX 4.0.5, ConfigureIIs is an internal IIS extension action that is
          NOT exported as a public WixAction symbol.  Referencing it with
          After="ConfigureIIs" causes linker error WIX0094 ("identifier
          'WixAction:InstallExecuteSequence/ConfigureIIs' could not be found").

        WHY Before="InstallFinalize" is correct:
          InstallFinalize is a standard MSI action (sequence 6600) that is always
          present and always resolvable.  The WiX IIS extension's ConfigureIIs
          action runs at sequence ~3700 — the IIS app pool and web site are fully
          created long before InstallFinalize fires, so both appcmd calls see an
          already-configured IIS environment.
      -->
      <Custom Action="SetAppPoolNoManagedCode"
              Before="InstallFinalize"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="SetIisBindingPort"
              Before="InstallFinalize"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />

      <!-- Install / Upgrade actions -->
      <!--
        PrepareTls runs after InstallFiles (SetupHelper.exe is on disk) and
        BEFORE WriteConfig: LocalMachine trust for the Laserfiche certificate
        must exist before the configuration is written and before the
        Dashboard app pool serves its first real API request.
      -->
      <Custom Action="PrepareTls"
              After="InstallFiles"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND LF_API_URL&lt;&gt;&quot;&quot;" />
      <Custom Action="WriteConfig"
              After="PrepareTls"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterExtension"
              After="WriteConfig"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackWebClient"
              After="RegisterExtension"
              Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="DeployWebClient"
              After="RollbackWebClient"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND INSTALL_WEB_BUTTON=&quot;1&quot; AND LF_WEB_CLIENT_PATH&lt;&gt;&quot;&quot;" />

      <!-- Uninstall actions -->
      <!--
        NOT UPGRADINGPRODUCTCODE (defense in depth): never strip the Dashboard
        button when this product is being removed as part of an upgrade: the
        replacing product owns the button from that point on.
      -->
      <Custom Action="RemoveWebClient"
              Before="UnregisterExtension"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND LF_WEB_CLIENT_PATH&lt;&gt;&quot;&quot;" />
      <Custom Action="UnregisterExtension"
              Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
