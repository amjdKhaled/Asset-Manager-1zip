<?xml version="1.0" encoding="utf-8"?>
<!--
  Product.wxs: Top-level package definition for the Dashboard installer.

  Defines the package identity, upgrade logic, features, UI, and custom actions.
  File content for WebApp and Extension is harvested via HarvestDirectory in
  Dashboard.Installer.wixproj (not listed as File elements here).

  Build requirements (Windows only):
    dotnet tool install -global wix
    wix extension add WixToolset.UI.wixext/4.0.5
    wix extension add WixToolset.Iis.wixext/4.0.3
    wix extension add WixToolset.Util.wixext/4.0.5
    dotnet build installer\Dashboard.Installer\Dashboard.Installer.wixproj

  To build with an explicit version or port:
    dotnet build ... -p:ProductVersion=1.2.3 -p:DashboardPort=80
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>

  <Package Name="Dashboard"
           Language="1033"
           Version="$(ProductVersion)"
           Manufacturer="Dashboard"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <!--
      MajorUpgrade: remove the old version before installing the new one.
      Configuration in %ProgramData%\Dashboard\ is preserved because those
      components use NeverOverwrite="yes" in Configuration.wxs.
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Dashboard is already installed. Downgrade is not supported. Please uninstall the current version first."
      Schedule="afterInstallInitialize" />

    <!--
      Prerequisite: ASP.NET Core 8 Hosting Bundle.
      The Hosting Bundle writes a Version value under this key on 64-bit Windows.
      If the property remains unset the Launch condition blocks installation.
    -->
    <Property Id="ASPNETCORE8">
      <RegistrySearch Id="DotNet8HostSearch"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version"
                      Win64="yes"
                      Type="raw" />
    </Property>

    <Launch
      Condition="ASPNETCORE8"
      Message="The ASP.NET Core 8 Hosting Bundle is required but was not found.

Download from: https://dotnet.microsoft.com/download/dotnet/8.0
Choose the Windows Hosting Bundle, then re-run this installer." />

    <!-- Directory structure -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(InstallFolderName)">
        <Directory Id="WEBAPPFOLDER"    Name="WebApp" />
        <Directory Id="EXTENSIONFOLDER" Name="Extension" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATAFOLDER" Name="Dashboard">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="STARTMENUFOLDER" Name="$(StartMenuFolder)" />
    </StandardDirectory>

    <!-- Features -->
    <!--
      Feature tree:
        [Required] Dashboard Web Application (always installed)
          [Optional] Laserfiche Desktop Client Extension
    -->
    <Feature Id="FeatureWebApp"
             Title="Dashboard Web Application"
             Description="Installs the Dashboard ASP.NET Core web application and configures IIS."
             Level="1"
             Absent="disallow"
             AllowAdvertise="no"
             Display="expand">

      <ComponentGroupRef Id="WebAppComponents" />
      <ComponentGroupRef Id="IisComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />

      <Feature Id="FeatureExtension"
               Title="Laserfiche Desktop Client Extension"
               Description="Adds a Dashboard button to the Laserfiche Desktop Client toolbar. Requires the Laserfiche Desktop Client to be installed."
               Level="1"
               AllowAdvertise="no">
        <ComponentGroupRef Id="ExtensionComponents" />
      </Feature>

    </Feature>

    <!-- Installer UI -->
    <!--
      WixUI_FeatureTree: Welcome, License, Custom Setup, Install Dir, Install, Finish.
      Replace License.rtf with your organisation licence for production distribution.
    -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp"  Value="Banner.bmp"  Overridable="yes" />
    <WixVariable Id="WixUIDialogBmp"  Value="Dialog.bmp"  Overridable="yes" />

    <!-- Custom actions: Desktop Extension registration -->
    <!--
      RegisterExtension: runs Dashboard.DesktopExtension.exe with the -setup -silent
      arguments after files are installed (fresh install or upgrade).
        Execute="deferred" + Impersonate="no": runs elevated so ClientAutomation
        SDK has write access to the Laserfiche toolbar registry.
        Return="ignore": if Laserfiche Desktop Client is not installed the EXE
        exits non-zero but the MSI install still succeeds.

      UnregisterExtension: runs with -remove -silent before files are removed.
      Scheduled Before="RemoveFiles" so the EXE is still on disk when it runs.

      Note: the ExeCommand attributes below use the correct double-dash CLI syntax
      required by the extension. Comments use single-dash for XML compatibility.
    -->
    <CustomAction Id="RegisterExtension"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.DesktopExtension.exe" --setup --silent'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterExtension"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.DesktopExtension.exe" --remove --silent'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Sequence custom actions.

      RegisterExtension:   After="InstallFiles" when NOT uninstalling.
                           Covers fresh install and upgrade. MajorUpgrade removes
                           old binaries then runs InstallFiles for new ones, so
                           re-running setup updates the command path.

      UnregisterExtension: Before="RemoveFiles" on full uninstall only.
    -->
    <InstallExecuteSequence>
      <Custom Action="RegisterExtension"   After="InstallFiles">NOT REMOVE~="ALL"</Custom>
      <Custom Action="UnregisterExtension" Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>

  </Package>
</Wix>
