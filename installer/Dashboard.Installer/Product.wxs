<?xml version="1.0" encoding="utf-8"?>
<!--
  Product.wxs: Top-level package definition for the Dashboard installer.

  Defines the package identity, upgrade logic, features, UI, and custom actions.
  File content for WebApp and Extension is harvested via HarvestDirectory in
  Dashboard.Installer.wixproj (not listed as File elements here).

  Build requirements (Windows only):
    dotnet tool install -global wix
    wix extension add WixToolset.UI.wixext/4.0.5
    wix extension add WixToolset.Iis.wixext/4.0.3
    wix extension add WixToolset.Util.wixext/4.0.5
    dotnet build installer\Dashboard.Installer\Dashboard.Installer.wixproj

  To build with an explicit version or port:
    dotnet build ... -p:ProductVersion=1.2.3 -p:DashboardPort=80
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Variables.wxi ?>

  <Package Name="Dashboard"
           Language="1033"
           Version="$(ProductVersion)"
           Manufacturer="Dashboard"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <!--
      MajorUpgrade: remove the old version before installing the new one.
      Configuration in %ProgramData%\Dashboard\ is preserved because those
      components use NeverOverwrite="yes" in Configuration.wxs.
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Dashboard is already installed. Downgrade is not supported. Please uninstall the current version first."
      Schedule="afterInstallInitialize" />

    <!--
      Prerequisite: ASP.NET Core 8 Hosting Bundle.
      The Hosting Bundle writes a Version value under this key on 64-bit Windows.
      If the property remains unset the Launch condition blocks installation.
    -->
    <Property Id="ASPNETCORE8">
      <RegistrySearch Id="DotNet8HostSearch"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version"
                      Win64="yes"
                      Type="raw" />
    </Property>

    <Launch
      Condition="ASPNETCORE8"
      Message="The ASP.NET Core 8 Hosting Bundle is required but was not found.

Download from: https://dotnet.microsoft.com/download/dotnet/8.0
Choose the Windows Hosting Bundle, then re-run this installer." />

    <!-- Directory structure -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(InstallFolderName)">
        <Directory Id="WEBAPPFOLDER"    Name="WebApp" />
        <Directory Id="EXTENSIONFOLDER" Name="Extension" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATAFOLDER" Name="Dashboard">
        <Directory Id="LOGSFOLDER" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="STARTMENUFOLDER" Name="$(StartMenuFolder)" />
    </StandardDirectory>

    <!-- Features -->
    <!--
      Feature tree:
        [Required] Dashboard Web Application (always installed)
          [Optional] Laserfiche Desktop Client Extension
    -->
    <Feature Id="FeatureWebApp"
             Title="Dashboard Web Application"
             Description="Installs the Dashboard ASP.NET Core web application and configures IIS."
             Level="1"
             Absent="disallow"
             AllowAdvertise="no"
             Display="expand">

      <ComponentGroupRef Id="WebAppComponents" />
      <ComponentGroupRef Id="IisComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />

      <Feature Id="FeatureExtension"
               Title="Laserfiche Desktop Client Extension"
               Description="Adds a Dashboard button to the Laserfiche Desktop Client toolbar. Requires the Laserfiche Desktop Client to be installed."
               Level="1"
               AllowAdvertise="no">
        <ComponentGroupRef Id="ExtensionComponents" />
      </Feature>

    </Feature>

    <!-- Installer UI -->
    <!--
      WixUI_FeatureTree: Welcome, License, Custom Setup, Install Dir, Install, Finish.
      Replace License.rtf with your organisation licence for production distribution.
    -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp"  Value="Banner.bmp"  Overridable="yes" />
    <WixVariable Id="WixUIDialogBmp"  Value="Dialog.bmp"  Overridable="yes" />

    <!--
      MSI Properties set by the Burn Bundle wizard (via MsiProperty in Bundle.wxs).
      When the MSI is run standalone (no Bundle), these are empty; the operator
      must supply them via the command line or run the Bundle instead.
    -->
    <Property Id="DASHBOARD_URL"          Value="" />
    <Property Id="LF_API_URL"             Value="" />
    <Property Id="LF_REPO_ID"             Value="" />
    <Property Id="LF_DISPLAY_NAME"        Value="" />
    <Property Id="LF_WEB_CLIENT_PATH"     Value="" />
    <Property Id="INSTALL_DESKTOP_BUTTON" Value="1" />
    <Property Id="INSTALL_WEB_BUTTON"     Value="0" />
    <Property Id="DASHBOARD_PORT"         Value="5000" />

    <!-- Custom actions: Desktop Extension registration -->
    <!--
      RegisterExtension: runs Dashboard.DesktopExtension.exe with the --setup --silent
      arguments after files are installed (fresh install or upgrade).
        Execute="deferred" + Impersonate="no": runs elevated so ClientAutomation
        SDK has write access to the Laserfiche toolbar registry.
        Return="ignore": if Laserfiche Desktop Client is not installed the EXE
        exits non-zero but the MSI install still succeeds.

      UnregisterExtension: runs with --remove --silent before files are removed.
      Scheduled Before="RemoveFiles" so the EXE is still on disk when it runs.
    -->
    <CustomAction Id="RegisterExtension"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.DesktopExtension.exe" --setup --silent'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterExtension"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.DesktopExtension.exe" --remove --silent'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Custom actions: SetupHelper EXE operations.

      WriteConfig:
        Writes extension.config.json and laserfiche.config.json to %ProgramData%\Dashboard\.
        Must run AFTER InstallFiles (so Dashboard.SetupHelper.exe is on disk).
        Execute=deferred + Impersonate=no: elevated write access to %ProgramData%.
        Return=check: config is required; failure aborts installation cleanly.

      DeployWebClient:
        Copies lf-dashboard-button.js and patches Browse.aspx.
        Return=ignore: web client integration is optional; failure is non-fatal.
        Condition: only when INSTALL_WEB_BUTTON=1 and a path is provided.

      RollbackWebClient (rollback):
        Restores Browse.aspx from the most recent .bak file.
        Fires automatically if DeployWebClient ran and a later CA fails.
        Return=ignore: best-effort rollback.

      RemoveWebClient:
        Removes the Dashboard script tag from Browse.aspx on uninstall.
        Return=ignore: optional cleanup; if Browse.aspx was already removed, skip.

      SECURITY NOTE: LF_WEB_CLIENT_PATH comes from the wizard (no user input
      during install); it is persisted in the Bundle DB and re-used on uninstall.
      No passwords or credentials are passed to any SetupHelper command.
    -->

    <CustomAction Id="WriteConfig"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --write-config --url "[DASHBOARD_URL]" --lf-api "[LF_API_URL]" --repo-id "[LF_REPO_ID]" --display-name "[LF_DISPLAY_NAME]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="DeployWebClient"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --deploy-webclient --url "[DASHBOARD_URL]" --path "[LF_WEB_CLIENT_PATH]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RollbackWebClient"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --rollback-webclient --path "[LF_WEB_CLIENT_PATH]"'
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveWebClient"
                  Directory="EXTENSIONFOLDER"
                  ExeCommand='"[EXTENSIONFOLDER]Dashboard.SetupHelper.exe" --remove-webclient --path "[LF_WEB_CLIENT_PATH]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Install execute sequence.

      On install / upgrade (NOT REMOVE):
        InstallFiles              (MSI built-in: copies all harvested files)
        WriteConfig               (writes %ProgramData%\Dashboard\ config files)
        RegisterExtension         (registers the Desktop Client toolbar button)
        RollbackWebClient         (rollback CA: restores Browse.aspx if later step fails)
        DeployWebClient           (patches Browse.aspx -- conditioned on wizard choice)

      On uninstall (REMOVE="ALL"):
        RemoveWebClient           (strips Dashboard tag from Browse.aspx)
        UnregisterExtension       (removes toolbar button registration)
        RemoveFiles               (MSI built-in: deletes installed files)
    -->
    <InstallExecuteSequence>
      <!-- Install / Upgrade actions -->
      <Custom Action="WriteConfig"
              After="InstallFiles">NOT REMOVE~="ALL"</Custom>
      <Custom Action="RegisterExtension"
              After="WriteConfig">NOT REMOVE~="ALL"</Custom>
      <Custom Action="RollbackWebClient"
              After="RegisterExtension">NOT REMOVE~="ALL"</Custom>
      <Custom Action="DeployWebClient"
              After="RollbackWebClient">NOT REMOVE~="ALL" AND INSTALL_WEB_BUTTON="1" AND LF_WEB_CLIENT_PATH&lt;&gt;""</Custom>

      <!-- Uninstall actions -->
      <Custom Action="RemoveWebClient"
              Before="UnregisterExtension">REMOVE~="ALL" AND LF_WEB_CLIENT_PATH&lt;&gt;""</Custom>
      <Custom Action="UnregisterExtension"
              Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>

  </Package>
</Wix>
