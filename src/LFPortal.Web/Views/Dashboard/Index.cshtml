@model LFPortal.Web.Controllers.DashboardViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@using LFPortal.Domain.Entities
@{
    ViewData["Title"] = "Analytics Dashboard";
    var s = Model.Stats;

    string FmtDate(DateTimeOffset? d) =>
        d is null ? "-" : d.Value.LocalDateTime.ToString("MMM d, yyyy HH:mm");

    string FmtDateShort(DateTimeOffset? d) =>
        d is null ? "-" : d.Value.LocalDateTime.ToString("MMM d, yyyy");

    string FmtAgo(DateTimeOffset? d)
    {
        if (d is null) return "-";
        var diff = DateTimeOffset.UtcNow - d.Value;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 30) return $"{(int)diff.TotalDays}d ago";
        return $"{(int)(diff.TotalDays / 30)}mo ago";
    }

    string FolderFromPath(string? fp)
    {
        if (string.IsNullOrWhiteSpace(fp)) return "-";
        var sep = fp.LastIndexOfAny(['\\', '/']);
        return sep > 0 ? fp[..sep] : "-";
    }

    string FmtMs(long ms) => ms < 1000 ? $"{ms}ms" : $"{ms / 1000.0:F1}s";

    // Chart JSON payloads — Folders + Templates
    var folderLabels = s.RootFolders.Select(f => f.Name).ToArray();
    var folderData   = s.RootFolders.Select(f => f.Documents).ToArray();
    var tmplLabels   = s.TemplateStats.Select(t => t.Name).ToArray();
    var tmplData     = s.TemplateStats.Select(t => t.Count).ToArray();

    // ── Document Activity chart data ──────────────────────────────────────────
    // Merge all available documents (deduplicated by Id)
    var allDocsForActivity = s.AllDocs
        .Concat(s.RecentDocs)
        .Concat(s.ModifiedDocs)
        .GroupBy(d => d.Id)
        .Select(g => g.First())
        .ToList();

    var today = DateTimeOffset.UtcNow.Date;

    var createdByDay  = allDocsForActivity
        .Where(d => d.CreationTime.HasValue)
        .GroupBy(d => d.CreationTime!.Value.LocalDateTime.Date)
        .ToDictionary(g => g.Key, g => g.Count());

    var modifiedByDay = allDocsForActivity
        .Where(d => d.LastModifiedTime.HasValue)
        .GroupBy(d => d.LastModifiedTime!.Value.LocalDateTime.Date)
        .ToDictionary(g => g.Key, g => g.Count());

    var allActivityDates = createdByDay.Keys.Concat(modifiedByDay.Keys).ToHashSet();

    DateTime actStart, actEnd;
    string actRangeLabel;
    if (allActivityDates.Count > 0)
    {
        var sevenDaysAgo  = today.AddDays(-6);
        var thirtyDaysAgo = today.AddDays(-29);
        var hasRecent7    = allActivityDates.Any(d => d >= sevenDaysAgo);
        var hasRecent30   = allActivityDates.Any(d => d >= thirtyDaysAgo);

        if (hasRecent7)
        {
            actStart      = sevenDaysAgo;
            actEnd        = today;
            actRangeLabel = "Last 7 days";
        }
        else if (hasRecent30)
        {
            actStart      = thirtyDaysAgo;
            actEnd        = today;
            actRangeLabel = "Last 30 days";
        }
        else
        {
            var earliest  = allActivityDates.Min();
            var latest    = allActivityDates.Max();
            actStart      = earliest;
            actEnd        = latest;
            actRangeLabel = $"{earliest:MMM d} – {latest:MMM d, yyyy}";
        }
    }
    else
    {
        actStart      = today.AddDays(-6);
        actEnd        = today;
        actRangeLabel = "Last 7 days";
    }

    var actLabels   = new List<string>();
    var actCreated  = new List<int>();
    var actModified = new List<int>();
    for (var day = actStart; day <= actEnd; day = day.AddDays(1))
    {
        actLabels.Add(day.ToString("MMM d"));
        actCreated.Add(createdByDay.GetValueOrDefault(day, 0));
        actModified.Add(modifiedByDay.GetValueOrDefault(day, 0));
    }

    // Recent Document Activity panel — top 8 by last-modified desc
    var recentActivity = s.ModifiedDocs.Take(8).ToList();

    // User activity
    var userActivity = s.AllDocs
        .Where(d => !string.IsNullOrWhiteSpace(d.Creator))
        .GroupBy(d => d.Creator!)
        .Select(g => new {
            Name         = g.Key,
            Created      = g.Count().ToString("N0"),
            LastActivity = FmtAgo(
                g.OrderByDescending(d => d.LastModifiedTime ?? d.CreationTime)
                 .First().LastModifiedTime
                ?? g.OrderByDescending(d => d.CreationTime).First().CreationTime)
        })
        .OrderByDescending(u => int.Parse(u.Created.Replace(",", "")))
        .ToList();

    var jsonOpts = new JsonSerializerOptions { DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
}

@section Styles {
<style>
body   { background: #0f172a !important; }
main   { max-width: 1440px !important; padding: 18px 22px !important; }
footer.site-footer { background: #0a1020 !important; }

:root {
    --d-bg:      #0f172a;
    --d-surface: #1e293b;
    --d-surf2:   #263349;
    --d-border:  #334155;
    --d-text:    #f1f5f9;
    --d-muted:   #94a3b8;
    --d-accent:  #3b82f6;
    --d-teal:    #14b8a6;
    --d-violet:  #8b5cf6;
    --d-green:   #22c55e;
    --d-orange:  #f97316;
    --d-red:     #ef4444;
}
.d-title   { color: var(--d-text); font-size: 1.2rem; font-weight: 600; }
.d-sub     { color: var(--d-muted); font-size: 0.78rem; margin-top: 2px; }
/* Cards — reduced padding vs original */
.d-card    { background: var(--d-surface); border: 1px solid var(--d-border); border-radius: 12px; padding: 18px; box-shadow: 0 1px 3px rgba(0,0,0,.4); }
.d-grid-5  { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; }
.d-grid-2  { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px; }
.d-grid-1  { display: grid; gap: 18px; }
.d-kpi-icon{ width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.d-kpi-val { font-size: 1.8rem; font-weight: 700; color: var(--d-text); }
.d-kpi-lbl { color: var(--d-muted); font-size: 0.75rem; margin-top:2px; }
.d-section-bar { width:4px;height:18px;border-radius:4px;background:var(--d-accent);display:inline-block;margin-right:8px;flex-shrink:0; }
.d-card-title  { color:var(--d-text);font-size:.83rem;font-weight:600; display:flex;align-items:center; }
.d-card-sub    { color:var(--d-muted);font-size:.72rem; }
.d-badge       { display:inline-flex;align-items:center;gap:4px;font-size:.68rem;padding:2px 8px;border-radius:999px;font-weight:500; }
.d-badge-teal  { background:rgba(20,184,166,.12);color:#2dd4bf;border:1px solid rgba(20,184,166,.25); }
.d-badge-blue  { background:rgba(59,130,246,.12);color:#60a5fa;border:1px solid rgba(59,130,246,.25); }
.d-badge-green { background:rgba(34,197,94,.12);color:#4ade80;border:1px solid rgba(34,197,94,.25); }
.d-badge-red   { background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.25); }
.d-badge-orange{ background:rgba(249,115,22,.12);color:#fb923c;border:1px solid rgba(249,115,22,.25); }
.d-badge-violet{ background:rgba(139,92,246,.12);color:#a78bfa;border:1px solid rgba(139,92,246,.25); }
.d-badge-indigo{ background:rgba(99,102,241,.12);color:#818cf8;border:1px solid rgba(99,102,241,.25); }
.d-tbl { width:100%;border-collapse:collapse;font-size:.77rem; }
.d-tbl th { text-align:left;padding:7px 11px;font-weight:600;color:var(--d-muted);background:rgba(255,255,255,.04);border-bottom:1px solid var(--d-border); }
.d-tbl td { padding:7px 11px;color:var(--d-text);border-bottom:1px solid rgba(51,65,85,.5); }
.d-tbl tr:hover td { background:rgba(255,255,255,.03); }
.d-tbl tr:last-child td { border-bottom:none; }
.d-tbl-wrap { overflow:hidden;border-radius:8px;border:1px solid var(--d-border); }
.d-empty { display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px;color:var(--d-muted);gap:8px; }
.d-health-cell { background:rgba(255,255,255,.04);border:1px solid var(--d-border);border-radius:8px;padding:10px; }
.d-health-lbl  { font-size:.71rem;color:var(--d-muted);margin-bottom:3px;display:flex;align-items:center;gap:6px; }
.d-health-val  { font-weight:600;color:var(--d-text);font-size:.83rem; word-break:break-all; }
.d-connected { color: var(--d-green); font-weight: 700; }
.d-disc      { color: var(--d-red); }
.d-alert { background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25);border-radius:12px;padding:12px 16px;display:flex;align-items:flex-start;gap:10px; }
.d-alert p { color:#fcd34d;font-size:.83rem;margin:0; }
/* Chart containers — fixed height, no aspect-ratio stretch */
.chart-container { position:relative; width:100%; }
.chart-h280 { height:280px; }
.chart-h270 { height:270px; }
/* Donut wrapper — cap size and center */
.donut-wrap { display:flex;flex-direction:column;align-items:center; }
.donut-wrap canvas { max-width:240px !important; max-height:240px !important; }
@@media(max-width:900px){.d-grid-5{grid-template-columns:repeat(2,1fr)}.d-grid-2{grid-template-columns:1fr}}
@@media(max-width:500px){.d-grid-5{grid-template-columns:1fr}}
</style>
}

<div style="color:var(--d-text)">

<!-- ── Header ─────────────────────────────────────────────────────────────── -->
<div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:18px">
    <div>
        <h1 class="d-title">📊 Analytics Dashboard</h1>
        <p class="d-sub">Laserfiche Repository Live Statistics</p>
    </div>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        @if (s.IsConnected && !string.IsNullOrWhiteSpace(s.RepositoryId))
        {
            <span class="d-badge d-badge-teal">
                <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="8"/></svg>
                @s.RepositoryId
            </span>
        }
        @if (!s.IsConnected)
        {
            <span class="d-badge d-badge-red">⚠ Not connected</span>
        }
        <a href="/Dashboard/Probe" style="display:inline-flex;align-items:center;gap:6px;background:var(--d-surf2);border:1px solid var(--d-border);color:var(--d-muted);padding:5px 13px;border-radius:8px;font-size:.8rem;text-decoration:none">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Probe API
        </a>
        <a href="/Dashboard" style="display:inline-flex;align-items:center;gap:6px;background:var(--d-surf2);border:1px solid var(--d-border);color:var(--d-text);padding:5px 13px;border-radius:8px;font-size:.8rem;text-decoration:none">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Refresh
        </a>
    </div>
</div>

<!-- ── Disconnected alert ─────────────────────────────────────────────────── -->
@if (!s.IsConnected)
{
    <div class="d-alert" style="margin-bottom:18px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p>@(s.ErrorMessage ?? "Dashboard is not connected to Laserfiche. Configure credentials in Settings.")</p>
    </div>
}

<!-- ── KPI Cards ──────────────────────────────────────────────────────────── -->
<div class="d-grid-5" style="margin-bottom:18px">
    <div class="d-card" style="display:flex;flex-direction:column;gap:10px">
        <div class="d-kpi-icon" style="background:rgba(59,130,246,.15)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="d-kpi-val">@s.TotalFolders.ToString("N0")</div>
        <div class="d-kpi-lbl">Total Folders</div>
    </div>
    <div class="d-card" style="display:flex;flex-direction:column;gap:10px">
        <div class="d-kpi-icon" style="background:rgba(20,184,166,.15)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div class="d-kpi-val">@s.TotalDocuments.ToString("N0")</div>
        <div class="d-kpi-lbl">Total Documents</div>
    </div>
    <div class="d-card" style="display:flex;flex-direction:column;gap:10px">
        <div class="d-kpi-icon" style="background:rgba(139,92,246,.15)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <div class="d-kpi-val">@s.TotalTemplates.ToString("N0")</div>
        <div class="d-kpi-lbl">Total Templates</div>
    </div>
    <div class="d-card" style="display:flex;flex-direction:column;gap:10px">
        <div class="d-kpi-icon" style="background:rgba(34,197,94,.15)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="d-kpi-val">@s.DocsWithTemplate.ToString("N0")</div>
        <div class="d-kpi-lbl">Docs with Template</div>
    </div>
    <div class="d-card" style="display:flex;flex-direction:column;gap:10px">
        <div class="d-kpi-icon" style="background:rgba(249,115,22,.15)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="d-kpi-val">@s.DocsWithoutTemplate.ToString("N0")</div>
        <div class="d-kpi-lbl">Docs without Template</div>
    </div>
</div>

@if (s.IsConnected)
{

<!-- ── Row 1: Documents by Folder + Template Distribution ─────────────────── -->
<div class="d-grid-2" style="margin-bottom:18px">

    <!-- Documents by Folder bar chart -->
    <div class="d-card">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px">
            <div>
                <div class="d-card-title"><span class="d-section-bar"></span>Documents by Folder</div>
                <div class="d-card-sub" style="margin-top:3px;margin-left:12px">Root-level folders · live from @s.RepositoryId</div>
            </div>
        </div>
        @if (s.RootFolders.Count == 0)
        {
            <div class="d-empty">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg>
                <span style="font-size:.8rem">No folder data available.</span>
            </div>
        }
        else
        {
            <div class="chart-container chart-h280">
                <canvas id="chartFolders"></canvas>
            </div>
        }
    </div>

    <!-- Template Distribution donut -->
    <div class="d-card">
        <div style="margin-bottom:12px">
            <div class="d-card-title"><span class="d-section-bar"></span>Template Distribution</div>
            <div class="d-card-sub" style="margin-top:3px;margin-left:12px">Auto-discovered · each template a different colour</div>
        </div>
        @if (s.TemplateStats.Count == 0)
        {
            <div class="d-empty">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg>
                <span style="font-size:.8rem">No templates assigned to documents.</span>
            </div>
        }
        else
        {
            <div class="chart-container chart-h280 donut-wrap">
                <canvas id="chartTemplates"></canvas>
            </div>
        }
    </div>
</div>

<!-- ── Row 2: Document Activity + Documents by User Activity ───────────────── -->
<div class="d-grid-2" style="margin-bottom:18px">

    <!-- Panel A: Document Activity chart -->
    <div class="d-card">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px">
            <div>
                <div class="d-card-title"><span class="d-section-bar" style="background:#14b8a6"></span>Document Activity</div>
                <div class="d-card-sub" style="margin-top:3px;margin-left:12px">@actRangeLabel · created vs. modified · real timestamps</div>
            </div>
        </div>
        @if (allActivityDates.Count == 0)
        {
            <div class="d-empty">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <span style="font-size:.8rem">No creation or modification timestamps found on scanned documents.</span>
            </div>
        }
        else
        {
            <div class="chart-container chart-h270">
                <canvas id="chartDocActivity"></canvas>
            </div>
        }
    </div>

    <!-- Panel B: Documents by User Activity -->
    <div class="d-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <div class="d-card-title"><span class="d-section-bar"></span>Documents by User Activity</div>
            <span class="d-badge d-badge-indigo">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                @userActivity.Count user@(userActivity.Count != 1 ? "s" : "") (LF)
            </span>
        </div>
        @if (userActivity.Count == 0)
        {
            <div class="d-empty">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span style="font-size:.8rem">No user activity data available (Creator field empty on all scanned documents).</span>
            </div>
        }
        else
        {
            <div class="d-tbl-wrap">
                <table class="d-tbl">
                    <thead><tr><th>User</th><th>Documents Created</th><th>Last Activity</th></tr></thead>
                    <tbody>
                        @foreach (var u in userActivity)
                        {
                            <tr>
                                <td style="font-weight:500">@u.Name</td>
                                <td style="color:var(--d-accent);font-weight:600">@u.Created</td>
                                <td style="color:var(--d-muted);white-space:nowrap">@u.LastActivity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ── Template Statistics table ─────────────────────────────────────────── -->
@if (s.TemplateStats.Count > 0)
{
<div class="d-card" style="margin-bottom:18px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div class="d-card-title"><span class="d-section-bar"></span>Template Statistics</div>
        <span class="d-badge d-badge-violet">@s.TemplateStats.Count template@(s.TemplateStats.Count != 1 ? "s" : "")</span>
    </div>
    <div class="d-tbl-wrap">
        <table class="d-tbl">
            <thead><tr><th>#</th><th>Template Name</th><th>Documents</th><th>% of Total</th></tr></thead>
            <tbody>
                @for (var i = 0; i < s.TemplateStats.Count; i++)
                {
                    var t = s.TemplateStats[i];
                    var pct = s.TotalDocuments > 0 ? (t.Count * 100.0 / s.TotalDocuments) : 0;
                    <tr>
                        <td style="color:var(--d-muted)">@(i + 1)</td>
                        <td style="font-weight:500">@t.Name</td>
                        <td style="color:var(--d-accent);font-weight:600">@t.Count.ToString("N0")</td>
                        <td style="color:var(--d-muted)">@pct.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

<!-- ── Document Type Distribution + System Health ─────────────────────────── -->
<div class="d-grid-2" style="margin-bottom:18px">
    <!-- Document Type Distribution -->
    <div class="d-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <div class="d-card-title"><span class="d-section-bar"></span>Document Type Distribution</div>
            <span class="d-badge d-badge-blue">By template / type</span>
        </div>
        @if (s.TemplateStats.Count == 0)
        {
            <div class="d-empty">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/></svg>
                <span style="font-size:.8rem">No document type data available.</span>
            </div>
        }
        else
        {
            var palette = new[]{"#3B82F6","#14B8A6","#F59E0B","#8B5CF6","#EF4444","#22C55E","#F97316","#06B6D4","#EC4899","#84CC16"};
            <div style="display:flex;flex-direction:column;gap:10px">
                @for (var i = 0; i < s.TemplateStats.Count; i++)
                {
                    var t = s.TemplateStats[i];
                    var color = palette[i % palette.Length];
                    <div style="display:flex;align-items:center;gap:10px">
                        <div style="width:11px;height:11px;border-radius:50%;background:@color;flex-shrink:0"></div>
                        <span style="flex:1;color:var(--d-text);font-size:.82rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@t.Name</span>
                        <span style="font-weight:700;color:var(--d-text);font-size:.82rem">@t.Count.ToString("N0")</span>
                    </div>
                }
            </div>
        }
    </div>

    <!-- System Health -->
    <div class="d-card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <div class="d-card-title"><span class="d-section-bar"></span>System Health</div>
            <span class="d-badge @(s.IsConnected ? "d-badge-green" : "d-badge-red")">
                @(s.IsConnected ? "✓ Connected" : "✗ Disconnected")
            </span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px">
            <div class="d-health-cell">
                <div class="d-health-lbl">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg> Status
                </div>
                <div class="d-health-val @(s.IsConnected ? "d-connected" : "d-disc")">@(s.IsConnected ? "Connected" : "Disconnected")</div>
            </div>
            <div class="d-health-cell">
                <div class="d-health-lbl">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg> Repository
                </div>
                <div class="d-health-val">@(s.RepositoryId ?? "N/A")</div>
            </div>
            <div class="d-health-cell" style="grid-column:span 2">
                <div class="d-health-lbl">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> Server URL
                </div>
                <div class="d-health-val">@(s.ServerUrl ?? "N/A")</div>
            </div>
            <div class="d-health-cell">
                <div class="d-health-lbl">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Username
                </div>
                <div class="d-health-val">@(s.ConnectedUser ?? "N/A")</div>
            </div>
            <div class="d-health-cell">
                <div class="d-health-lbl">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Last Refresh
                </div>
                <div class="d-health-val">@FmtAgo(s.LastCheckedAt)</div>
            </div>
            <div class="d-health-cell" style="grid-column:span 2">
                <div class="d-health-lbl">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Scan Duration
                </div>
                <div class="d-health-val">@FmtMs(s.ScanDurationMs)</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Recently Created Documents ─────────────────────────────────────────── -->
<div class="d-card" style="margin-bottom:18px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div class="d-card-title"><span class="d-section-bar"></span>Recently Created Documents</div>
        <span class="d-badge d-badge-teal">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            @s.RecentDocs.Count doc@(s.RecentDocs.Count != 1 ? "s" : "")
        </span>
    </div>
    @if (s.RecentDocs.Count == 0)
    {
        <div class="d-empty">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span style="font-size:.8rem">No recently created documents found.</span>
        </div>
    }
    else
    {
        <div class="d-tbl-wrap">
            <table class="d-tbl">
                <thead><tr><th>Document Name</th><th>Template</th><th>Folder</th><th>Created</th><th>Created By</th></tr></thead>
                <tbody>
                    @foreach (var d in s.RecentDocs)
                    {
                        <tr>
                            <td style="font-weight:500;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@d.Name">@d.Name</td>
                            <td style="color:var(--d-muted)">@(d.TemplateName ?? "-")</td>
                            <td style="color:var(--d-muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@FolderFromPath(d.FullPath)">@FolderFromPath(d.FullPath)</td>
                            <td style="color:var(--d-muted);white-space:nowrap">@FmtDate(d.CreationTime)</td>
                            <td style="color:var(--d-muted)">@(d.Creator ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="font-size:.71rem;color:var(--d-muted);margin-top:7px">@s.RecentDocs.Count document@(s.RecentDocs.Count != 1 ? "s" : "") tracked</div>
    }
</div>

<!-- ── Recent Document Activity ────────────────────────────────────────────── -->
<div class="d-card" style="margin-bottom:18px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div class="d-card-title"><span class="d-section-bar" style="background:#f97316"></span>Recent Document Activity</div>
        <span class="d-badge d-badge-orange">@recentActivity.Count doc@(recentActivity.Count != 1 ? "s" : "")</span>
    </div>
    @if (recentActivity.Count == 0)
    {
        <div class="d-empty">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span style="font-size:.8rem">No documents found in the repository scan.</span>
        </div>
    }
    else
    {
        <div class="d-tbl-wrap">
            <table class="d-tbl">
                <thead>
                    <tr>
                        <th>Document Name</th>
                        <th>Folder</th>
                        <th>Template</th>
                        <th>Created</th>
                        <th>Modified</th>
                        @if (recentActivity.Any(d => !string.IsNullOrWhiteSpace(d.Creator)))
                        {
                            <th>Creator</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in recentActivity)
                    {
                        <tr>
                            <td style="font-weight:500;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@d.Name">@d.Name</td>
                            <td style="color:var(--d-muted);max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@FolderFromPath(d.FullPath)">@FolderFromPath(d.FullPath)</td>
                            <td style="color:var(--d-muted)">@(d.TemplateName ?? "-")</td>
                            <td style="color:var(--d-muted);white-space:nowrap">@FmtDateShort(d.CreationTime)</td>
                            <td style="color:var(--d-accent);white-space:nowrap">@FmtAgo(d.LastModifiedTime ?? d.CreationTime)</td>
                            @if (recentActivity.Any(x => !string.IsNullOrWhiteSpace(x.Creator)))
                            {
                                <td style="color:var(--d-muted)">@(d.Creator ?? "-")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

} @* end if IsConnected *@

</div>@* end outer div *@

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function(){
const PALETTE = ["#3B82F6","#14B8A6","#F59E0B","#8B5CF6","#EF4444","#22C55E","#F97316","#06B6D4","#EC4899","#84CC16","#A855F7","#F43F5E","#10B981","#FBBF24","#60A5FA"];
const GRID    = "rgba(51,65,85,0.5)";
const TICK    = "#94a3b8";
const TOOLTIP = {
    backgroundColor:"#1e293b",
    borderColor:"#334155",
    borderWidth:1,
    titleColor:"#94a3b8",
    bodyColor:"#f1f5f9",
    padding:10,
    cornerRadius:8
};

// ── Folders bar chart ──────────────────────────────────────────────────────
const folderEl = document.getElementById("chartFolders");
if(folderEl){
    const labels = @Html.Raw(JsonSerializer.Serialize(folderLabels));
    const data   = @Html.Raw(JsonSerializer.Serialize(folderData));
    new Chart(folderEl, {
        type:"bar",
        data:{
            labels,
            datasets:[{
                label:"Documents",
                data,
                backgroundColor: labels.map((_,i)=>PALETTE[i%PALETTE.length]+"cc"),
                borderColor:     labels.map((_,i)=>PALETTE[i%PALETTE.length]),
                borderWidth:1,
                borderRadius:4,
                barPercentage:0.6,
                categoryPercentage:0.7
            }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            plugins:{legend:{display:false},tooltip:{...TOOLTIP,callbacks:{label:c=>`${c.formattedValue} documents`}}},
            scales:{
                x:{ticks:{color:TICK,maxRotation:40,font:{size:9}},grid:{color:GRID}},
                y:{ticks:{color:TICK,font:{size:9}},grid:{color:GRID},beginAtZero:true}
            }
        }
    });
}

// ── Template doughnut ─────────────────────────────────────────────────────
const tmplEl = document.getElementById("chartTemplates");
if(tmplEl){
    const labels = @Html.Raw(JsonSerializer.Serialize(tmplLabels));
    const data   = @Html.Raw(JsonSerializer.Serialize(tmplData));
    new Chart(tmplEl, {
        type:"doughnut",
        data:{
            labels,
            datasets:[{
                data,
                backgroundColor: labels.map((_,i)=>PALETTE[i%PALETTE.length]+"cc"),
                borderColor:"#1e293b",
                borderWidth:2
            }]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            plugins:{
                legend:{position:"bottom",labels:{color:TICK,boxWidth:11,padding:8,font:{size:9}}},
                tooltip:{...TOOLTIP}
            },
            layout:{ padding:{ top:8, bottom:0 } }
        }
    });
}

// ── Document Activity chart (created vs modified per day) ──────────────────
const docActEl = document.getElementById("chartDocActivity");
if(docActEl){
    const labels   = @Html.Raw(JsonSerializer.Serialize(actLabels));
    const created  = @Html.Raw(JsonSerializer.Serialize(actCreated));
    const modified = @Html.Raw(JsonSerializer.Serialize(actModified));
    new Chart(docActEl, {
        type:"bar",
        data:{
            labels,
            datasets:[
                {
                    label:"Created",
                    data:created,
                    backgroundColor:"rgba(59,130,246,0.75)",
                    borderColor:"#3B82F6",
                    borderWidth:1,
                    borderRadius:3,
                    barPercentage:0.55,
                    categoryPercentage:0.75
                },
                {
                    label:"Modified",
                    data:modified,
                    backgroundColor:"rgba(20,184,166,0.75)",
                    borderColor:"#14B8A6",
                    borderWidth:1,
                    borderRadius:3,
                    barPercentage:0.55,
                    categoryPercentage:0.75
                }
            ]
        },
        options:{
            responsive:true,
            maintainAspectRatio:false,
            plugins:{
                legend:{
                    display:true,
                    position:"top",
                    align:"end",
                    labels:{color:TICK,boxWidth:11,padding:10,font:{size:9}}
                },
                tooltip:{...TOOLTIP}
            },
            scales:{
                x:{ticks:{color:TICK,font:{size:9}},grid:{color:GRID}},
                y:{ticks:{color:TICK,font:{size:9}},grid:{color:GRID},beginAtZero:true,
                   ticks:{stepSize:1,color:TICK,font:{size:9}}}
            }
        }
    });
}
})();
</script>
}
