@model LFPortal.Web.Controllers.DocumentViewModel
@{ Layout = null; }
<div style="background:#edf1f7;border:1px solid #e1e5ed;border-radius:10px;padding:12px;text-align:center;min-height:160px">
@if (!string.IsNullOrWhiteSpace(Model.PreviewError))
{
    <p role="status">@Model.PreviewError</p>
}
else if (Model.Entry is {} entry && Model.IsInlineElectronicDocument)
{
    if (Model.ElectronicDocumentContentType == "application/pdf")
    {
        <iframe src="@Url.Action("Content", "Document", new { entryId = entry.Id })#toolbar=0&view=FitH" title="معاينة @entry.Name"
                style="width:100%;height:320px;border:0"></iframe>
    }
    else
    {
        <img src="@Url.Action("Content", "Document", new { entryId = entry.Id })" alt="@entry.Name" style="max-width:100%;max-height:300px;object-fit:contain" />
    }
}
else if (Model.Entry is {} pageEntry && Model.Pages.Count > 0)
{
    <img src="@Url.Action("PageImage", "Document", new { entryId = pageEntry.Id, pageNumber = Model.Pages[0].PageNumber })" alt="@pageEntry.Name"
         style="max-width:100%;max-height:300px;object-fit:contain" />
}
else
{
    <p role="status">لا توجد صورة لهذه الوثيقة.</p>
    @if (Model.HasElectronicDocument) { <small>يمكن تنزيل الملف الأصلي لعرض محتواه.</small> }
}
<p data-preview-error hidden role="status">تعذر تحميل صورة الوثيقة. افتح العارض أو أعد المحاولة.</p>
</div>
