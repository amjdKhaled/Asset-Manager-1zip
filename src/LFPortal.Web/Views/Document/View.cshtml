@model LFPortal.Web.Controllers.DocumentViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Entry?.Name ?? L["ViewDocument"].Value;
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string arabic, string english) => ar ? arabic : english;
    string FmtDate(DateTimeOffset? value) => value?.LocalDateTime.ToString("MMM d, yyyy HH:mm") ?? "—";
}
@section Styles {
<style>
body { background:#F7F8FD !important; font-family:"IBM Plex Sans Arabic","Segoe UI",Tahoma,Arial,sans-serif; }
main { max-width:1800px !important; padding:22px !important; }
footer.site-footer { background:#F7F8FD !important; }
.dv-back { display:inline-flex; margin-bottom:18px; color:#2563eb; text-decoration:none; }
.dv-header { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
.dv-title { color:#17233b; font-size:1.45rem; margin:0; overflow-wrap:anywhere; }
.dv-subtitle { color:#596b86; margin-top:6px; font-size:.82rem; }
.dv-actions,.dv-tools { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.dv-btn { display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:9px 13px;
          background:#fff; color:#17233b; border:1px solid #dce3ee; border-radius:9px; text-decoration:none; font-size:.8rem; cursor:pointer; }
.dv-btn:hover { background:#eff6ff; border-color:#3b82f6; }
.dv-btn:disabled { opacity:.45; cursor:default; }
.dv-btn-primary { background:#2563eb; border-color:#2563eb; color:#fff; }
.dv-btn-primary:hover { background:#1d4ed8; color:#fff; }
.dv-grid { display:grid; grid-template-columns:minmax(0,1fr) 290px; gap:18px; align-items:start; }
.dv-card { background:#fff; border:1px solid #e1e5ed; border-radius:16px; box-shadow:0 4px 18px rgba(15,23,42,.07); min-width:0; overflow:hidden; }
.dv-meta { padding:20px; max-height:calc(100vh - 220px); overflow:auto; }
.dv-section-title { font-weight:650; margin-bottom:14px; color:#17233b; border-inline-start:4px solid #3b82f6; padding-inline-start:10px; }
.dv-row { display:flex; justify-content:space-between; align-items:start; gap:12px; margin-bottom:12px; font-size:.8rem; }
.dv-label { color:#596b86; flex-shrink:0; }
.dv-value { color:#17233b; min-width:0; overflow-wrap:anywhere; text-align:end; unicode-bidi:plaintext; }
.dv-path { font-size:.76rem; color:#596b86; overflow-wrap:anywhere; unicode-bidi:plaintext; margin-bottom:20px; }
.dv-fields { width:100%; table-layout:fixed; border-collapse:collapse; font-size:.78rem; }
.dv-fields td,.dv-fields th { padding:9px 4px; border-bottom:1px solid #e8edf4; overflow-wrap:anywhere; text-align:start; }
.dv-fields th { color:#596b86; }
.dv-content-head { padding:12px 16px; border-bottom:1px solid #e1e5ed; display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; }
.dv-stage { height:calc(100vh - 250px); min-height:560px; overflow:auto; background:#edf1f7; position:relative; padding:24px; text-align:center; }
.dv-frame { width:100%; height:100%; min-height:510px; border:0; background:white; }
.dv-image { display:block; max-width:100%; max-height:100%; object-fit:contain; margin:auto; transform-origin:center; box-shadow:0 4px 22px rgba(15,23,42,.12); }
.dv-image.zoomed { max-width:none; max-height:none; }
.dv-empty { margin:80px auto; max-width:520px; color:#596b86; line-height:1.7; }
.dv-empty strong { display:block; color:#17233b; margin-bottom:14px; }
.dv-error { background:#fff1f2; border:1px solid #fecdd3; color:#9f1239; padding:16px; border-radius:10px; margin-bottom:16px; }
.dv-warn { color:#92400e; background:#fffbeb; padding:12px; border-radius:8px; font-size:.8rem; }
.dv-status { font-size:.8rem; color:#596b86; padding:10px 16px; border-top:1px solid #e1e5ed; }
.dv-status[hidden] { display:none; }
.dv-counter { min-width:70px; text-align:center; color:#596b86; font-size:.85rem; }
.dv-viewer:fullscreen { display:flex; flex-direction:column; border-radius:0; }
.dv-viewer:fullscreen .dv-stage { flex:1; height:auto; min-height:0; }
@@media(max-width:1000px) { .dv-grid { grid-template-columns:1fr; } .dv-meta { max-height:none; } }
@@media(max-width:600px) { main { padding:12px !important; } .dv-stage { padding:12px; min-height:420px; } .dv-frame { min-height:380px; } }
</style>
}
<a class="dv-back" href="@Model.ReturnUrl">@T("العودة إلى الأرشيف", "Back to Archive")</a>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="dv-error" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Entry is {} entry)
{
    <header class="dv-header">
        <div><h1 class="dv-title">@entry.Name</h1><div class="dv-subtitle">@L["EntryId"]: @entry.Id</div></div>
        <div class="dv-actions">
            @if (Model.HasElectronicDocument)
            {
                <a class="dv-btn dv-btn-primary" asp-action="Download" asp-route-entryId="@entry.Id">@L["DownloadOriginal"]</a>
            }
            <a class="dv-btn" href="@Model.ReturnUrl">@T("إغلاق", "Close")</a>
        </div>
    </header>
    <div class="dv-grid">
        <section class="dv-card dv-viewer" id="dvViewer" aria-label="@L["ViewDocument"]">
            <div class="dv-content-head">
                <div class="dv-tools">
                    @if (Model.Pages.Count > 0)
                    {
                        <button type="button" class="dv-btn" id="dvPrevBtn" disabled>@T("السابق", "Previous")</button>
                        <span class="dv-counter" id="dvPageCounter" dir="ltr">1 / @Model.Pages.Count</span>
                        <button type="button" class="dv-btn" id="dvNextBtn" disabled="@(Model.Pages.Count <= 1 ? "disabled" : null)">@T("التالي", "Next")</button>
                    }
                    else { <span class="dv-counter">@L["ViewDocument"]</span> }
                </div>
                <div class="dv-tools">
                    @if (Model.Pages.Count > 0 || (Model.IsInlineElectronicDocument && Model.ElectronicDocumentContentType != "application/pdf"))
                    {
                        <button type="button" class="dv-btn" id="dvZoomOut" aria-label="@T("تصغير", "Zoom out")">−</button>
                        <button type="button" class="dv-btn" id="dvFit">@T("ملاءمة الصفحة", "Fit page")</button>
                        <button type="button" class="dv-btn" id="dvZoomIn" aria-label="@T("تكبير", "Zoom in")">+</button>
                        <button type="button" class="dv-btn" id="dvRotate">@T("تدوير", "Rotate")</button>
                    }
                    <button type="button" class="dv-btn" id="dvFullScreen">@T("ملء الشاشة", "Full screen")</button>
                </div>
            </div>
            <div class="dv-stage" id="dvStage">
                @if (!string.IsNullOrWhiteSpace(Model.PreviewError))
                {
                    <div class="dv-empty" role="status"><strong>@Model.PreviewError</strong></div>
                }
                else if (Model.HasElectronicDocument && Model.IsInlineElectronicDocument)
                {
                    if (Model.ElectronicDocumentContentType == "application/pdf")
                    {
                        <iframe class="dv-frame" src="@Url.Action("Content", "Document", new { entryId = entry.Id })" title="@entry.Name"></iframe>
                    }
                    else
                    {
                        <img class="dv-image" id="dvImage" src="@Url.Action("Content", "Document", new { entryId = entry.Id })" alt="@entry.Name" />
                    }
                }
                else if (Model.Pages.Count > 0)
                {
                    <img class="dv-image" id="dvImage" src="@Url.Action("PageImage", "Document", new { entryId = entry.Id, pageNumber = Model.Pages[0].PageNumber })" alt="@entry.Name" />
                }
                else
                {
                    <div class="dv-empty">
                        <strong>@(Model.HasElectronicDocument ? T("هذا النوع من الملفات لا يدعم المعاينة داخل المتصفح.", "This file type cannot be previewed in the browser.") : T("لا توجد صورة لهذه الوثيقة.", "This document has no image."))</strong>
                        @if (Model.HasElectronicDocument) { <a class="dv-btn dv-btn-primary" asp-action="Download" asp-route-entryId="@entry.Id">@L["DownloadOriginal"]</a> }
                    </div>
                }
            </div>
            <div class="dv-status" id="dvStatus" role="status" hidden></div>
            @if (Model.HasElectronicDocument && Model.IsInlineElectronicDocument)
            {
                <div class="dv-status"><a asp-action="Content" asp-route-entryId="@entry.Id" target="_blank" rel="noopener">@T("فتح المحتوى في نافذة مستقلة", "Open content in a separate window")</a></div>
            }
        </section>
        <aside class="dv-card dv-meta">
            <div class="dv-section-title">@L["EntryInformation"]</div>
            <div class="dv-row"><span class="dv-label">@L["EntryId"]</span><span class="dv-value">@entry.Id</span></div>
            <div class="dv-row"><span class="dv-label">@L["Template"]</span><span class="dv-value">@(entry.TemplateName ?? "—")</span></div>
            <div class="dv-row"><span class="dv-label">@L["Created"]</span><span class="dv-value">@FmtDate(entry.CreationTime)</span></div>
            <div class="dv-row"><span class="dv-label">@L["Modified"]</span><span class="dv-value">@FmtDate(entry.LastModifiedTime ?? entry.CreationTime)</span></div>
            <div class="dv-row"><span class="dv-label">@L["CreatedBy"]</span><span class="dv-value">@(entry.Creator ?? "—")</span></div>
            <div class="dv-row"><span class="dv-label">@L["Pages"]</span><span class="dv-value">@(entry.PageCount?.ToString() ?? "—")</span></div>
            <div class="dv-section-title">@L["RepositoryPath"]</div>
            <div class="dv-path">@Model.Path</div>
            <div class="dv-section-title">@L["MetadataFields"]</div>
            @if (!string.IsNullOrWhiteSpace(Model.FieldsError)) { <div class="dv-warn">@Model.FieldsError</div> }
            else if (Model.Fields.Count == 0) { <div class="dv-path">@T("لا توجد قيم حقول مسجلة.", "No field values recorded.")</div> }
            else
            {
                <table class="dv-fields"><thead><tr><th>@T("الحقل", "Field")</th><th>@T("القيمة", "Value")</th></tr></thead><tbody>
                @foreach (var field in Model.Fields) { <tr><td>@field.FieldName</td><td>@(field.Value ?? "—")</td></tr> }
                </tbody></table>
            }
        </aside>
    </div>
}
@section Scripts {
<script>
(function () {
    const viewer = document.getElementById('dvViewer');
    if (!viewer) return;
    const img = document.getElementById('dvImage');
    const status = document.getElementById('dvStatus');
    const pages = @Html.Raw(JsonSerializer.Serialize(Model.Pages.Select(page => page.PageNumber)));
    const pageUrl = @Html.Raw(JsonSerializer.Serialize(Url.Action("PageImage", "Document", new { entryId = Model.Entry?.Id, pageNumber = 1 })));
    const loadingText = @Html.Raw(JsonSerializer.Serialize(T("جاري تحميل الصفحة…", "Loading page…")));
    const errorText = @Html.Raw(JsonSerializer.Serialize(T("تعذر تحميل الصورة. تحقق من الاتصال أو أعد المحاولة.", "The image could not be loaded. Check the connection or retry.")));
    const retryText = @Html.Raw(JsonSerializer.Serialize(T("إعادة المحاولة", "Retry")));
    let index = 0, zoom = 1, rotation = 0;
    function fit() {
        zoom = 1; rotation = 0;
        if (img) { img.classList.remove('zoomed'); img.style.width = ''; img.style.transform = ''; }
    }
    function transform() {
        if (!img || !img.naturalWidth) return;
        img.classList.add('zoomed'); img.style.width = (img.naturalWidth * zoom) + 'px';
        img.style.transform = 'rotate(' + rotation + 'deg)';
    }
    function navigate(delta) {
        const target = index + delta;
        if (!img || target < 0 || target >= pages.length) return;
        index = target; fit();
        const url = new URL(pageUrl, window.location.origin);
        // Use MVC query parameters instead of assuming a custom route exists.
        url.pathname = url.pathname.replace(/\/1$/, '/' + pages[index]);
        url.searchParams.set('pageNumber', pages[index]);
        img.src = url.toString();
        document.getElementById('dvPageCounter').textContent = (index + 1) + ' / ' + pages.length;
        document.getElementById('dvPrevBtn').disabled = index === 0;
        document.getElementById('dvNextBtn').disabled = index === pages.length - 1;
        status.hidden = false; status.textContent = loadingText;
    }
    document.getElementById('dvPrevBtn')?.addEventListener('click', () => navigate(-1));
    document.getElementById('dvNextBtn')?.addEventListener('click', () => navigate(1));
    document.getElementById('dvFit')?.addEventListener('click', fit);
    document.getElementById('dvZoomIn')?.addEventListener('click', () => { zoom = Math.min(3, zoom + .25); transform(); });
    document.getElementById('dvZoomOut')?.addEventListener('click', () => { zoom = Math.max(.25, zoom - .25); transform(); });
    document.getElementById('dvRotate')?.addEventListener('click', () => { rotation = (rotation + 90) % 360; transform(); });
    document.getElementById('dvFullScreen')?.addEventListener('click', async () => {
        try { if (document.fullscreenElement) await document.exitFullscreen(); else await viewer.requestFullscreen(); }
        catch { status.hidden = false; status.textContent = @Html.Raw(JsonSerializer.Serialize(T("ملء الشاشة غير متاح في هذا المتصفح.", "Full screen is unavailable in this browser."))); }
    });
    if (img) {
        img.addEventListener('load', () => { img.hidden = false; status.hidden = true; });
        img.addEventListener('error', () => {
            img.hidden = true; status.hidden = false; status.textContent = errorText + ' ';
            const retry = document.createElement('button'); retry.type = 'button'; retry.className = 'dv-btn'; retry.textContent = retryText;
            retry.addEventListener('click', () => { const url = new URL(img.src); url.searchParams.set('retry', Date.now()); img.src = url.toString(); status.textContent = loadingText; });
            status.appendChild(retry);
        });
        if (img.complete && img.naturalWidth === 0) img.dispatchEvent(new Event('error'));
    }
})();
</script>
}
