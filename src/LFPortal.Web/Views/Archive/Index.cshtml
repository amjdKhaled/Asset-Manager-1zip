@model LFPortal.Web.Controllers.ArchiveViewModel
@using LFPortal.Domain.Entities
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Archive";

    string FmtDate(DateTimeOffset? d) =>
        d is null ? "—" : d.Value.LocalDateTime.ToString("MMM d, yyyy");

    string FmtAgo(DateTimeOffset? d)
    {
        if (d is null) return "—";
        var diff = DateTimeOffset.UtcNow - d.Value;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 30) return $"{(int)diff.TotalDays}d ago";
        return d.Value.LocalDateTime.ToString("MMM d, yyyy");
    }

    // Build the trail string that links INTO a child folder from the current location.
    // Format: existing trail + "|" + currentEntryId + ":" + Uri.EscapeDataString(currentName)
    // (leading "|" is trimmed when trail is empty)
    string BuildChildTrail()
    {
        var seg = $"{Model.CurrentEntryId}:{Uri.EscapeDataString(Model.CurrentName)}";
        return string.IsNullOrEmpty(Model.Trail) ? seg : $"{Model.Trail}|{seg}";
    }

    var childTrail = BuildChildTrail();

    var folders   = Model.Entries.Where(e => e.EntryType == LFEntryType.Folder).ToList();
    var documents = Model.Entries.Where(e => e.EntryType != LFEntryType.Folder).ToList();
    var templates = Model.Templates;

    string BuildPageUrl(int targetPage)
    {
        var values = Context.Request.Query.ToDictionary(
            pair => pair.Key,
            pair => pair.Value.ToString(),
            StringComparer.OrdinalIgnoreCase);
        values["page"] = targetPage.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return QueryString.Create(values.Select(pair =>
            new KeyValuePair<string, string?>(pair.Key, pair.Value))).ToUriComponent();
    }

    var pageWindowStart = Math.Min(Math.Max(1, Model.PageNumber - 2), Math.Max(1, Model.TotalPages - 4));
    var pageWindowEnd = Math.Min(pageWindowStart + 4, Model.TotalPages);
}

@section Styles {
<style>
/* Archive identity follows the dashboard palette. */
body   { background: #F7F8FD !important; font-family:"IBM Plex Sans Arabic","Segoe UI",Tahoma,Arial,sans-serif; }
main   { max-width: 1440px !important; padding: 18px 22px !important; }
footer.site-footer { background: #F7F8FD !important; }

:root {
    --a-bg:      #F7F8FD;
    --a-surface: #FFFFFF;
    --a-surf2:   #f1f5fb;
    --a-border:  #e1e5ed;
    --a-text:    #17233b;
    --a-muted:   #596b86;
    --a-accent:  #3b82f6;
    --a-teal:    #14b8a6;
    --a-green:   #22c55e;
    --a-orange:  #f97316;
    --a-red:     #ef4444;
    --a-yellow:  #f59e0b;
}

/* Page title row */
.arc-header { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:16px; }
.arc-title  { color:var(--a-text); font-size:1.2rem; font-weight:600; }
.arc-sub    { color:var(--a-muted); font-size:.78rem; margin-top:2px; }

/* Breadcrumb */
.arc-crumb  { display:flex; align-items:center; flex-wrap:wrap; gap:4px; font-size:.82rem; margin-bottom:16px;
               background:var(--a-surface); border:1px solid var(--a-border); border-radius:8px; padding:9px 14px; }
.arc-crumb a   { color:var(--a-accent); text-decoration:none; }
.arc-crumb a:hover { text-decoration:underline; }
.arc-crumb-sep { color:var(--a-muted); padding:0 2px; }
.arc-crumb-cur { color:var(--a-text); font-weight:600; }

/* Toolbar */
.arc-toolbar { display:flex; align-items:center; gap:10px; margin-bottom:14px; flex-wrap:wrap; }
.arc-filter   { flex:1; min-width:200px; max-width:400px; background:var(--a-surf2);
                border:1px solid var(--a-border); border-radius:8px; padding:7px 12px;
                color:var(--a-text); font-size:.83rem; outline:none; }
.arc-filter::placeholder { color:var(--a-muted); }
.arc-filter:focus { border-color:var(--a-accent); box-shadow:0 0 0 2px rgba(59,130,246,.2); }
.arc-count  { color:var(--a-muted); font-size:.78rem; white-space:nowrap; }
.arc-open-lf { display:inline-flex;align-items:center;gap:6px;background:var(--a-accent);border:1px solid var(--a-accent);
               color:#fff;padding:7px 12px;border-radius:8px;font-size:.78rem;text-decoration:none;white-space:nowrap; }
.arc-open-lf:hover { color:#fff;filter:brightness(1.08); }
.arc-pager { display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;padding:14px; }
.arc-page { min-width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--a-border);
            border-radius:7px;background:var(--a-surf2);color:var(--a-text);text-decoration:none;font-size:.76rem;padding:0 9px; }
.arc-page.active { background:var(--a-accent);border-color:var(--a-accent);color:#fff; }
.arc-page.disabled { opacity:.45;pointer-events:none; }
.arc-page-input { width:58px;height:34px;border:1px solid var(--a-border);border-radius:7px;background:var(--a-surf2);
                  color:var(--a-text);text-align:center;font-size:.76rem; }

/* Main card */
.arc-card   { background:var(--a-surface); border:1px solid var(--a-border); border-radius:12px;
               box-shadow:0 1px 3px rgba(15,23,42,.08); overflow:hidden; }

/* Table */
.arc-tbl    { width:100%; border-collapse:collapse; font-size:.8rem; }
.arc-tbl th { text-align:left; padding:9px 14px; font-weight:600; color:var(--a-muted);
               background:rgba(255,255,255,.04); border-bottom:1px solid var(--a-border);
               white-space:nowrap; cursor:pointer; user-select:none; }
.arc-tbl th:hover { color:var(--a-text); }
.arc-tbl th .sort-icon { font-size:.65rem; margin-left:4px; opacity:.5; }
.arc-tbl th.sorted .sort-icon { opacity:1; color:var(--a-accent); }
.arc-tbl td { padding:9px 14px; color:var(--a-text); border-bottom:1px solid #e8edf4; vertical-align:middle; }
.arc-tbl tr:last-child td { border-bottom:none; }
.arc-tbl tr:hover td { background:#eff6ff; }

/* Entry name cell */
.arc-name   { display:flex; align-items:center; gap:9px; }
.arc-name a { color:var(--a-text); text-decoration:none; font-weight:500; }
.arc-name a:hover { color:var(--a-accent); text-decoration:underline; }
.arc-name-folder a { color:var(--a-yellow); }
.arc-name-folder a:hover { color:#b45309; }

/* Icons */
.arc-icon { flex-shrink:0; }

/* Type badge */
.arc-badge { display:inline-flex; align-items:center; padding:2px 8px; border-radius:4px;
              font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
.arc-badge-folder   { background:rgba(245,158,11,.12); color:#b45309; border:1px solid rgba(245,158,11,.2); }
.arc-badge-document { background:rgba(59,130,246,.12);  color:#2563eb; border:1px solid rgba(59,130,246,.2); }
.arc-badge-shortcut { background:rgba(148,163,184,.1);  color:#596b86; border:1px solid rgba(148,163,184,.2); }
.arc-badge-other    { background:rgba(148,163,184,.1);  color:#596b86; border:1px solid rgba(148,163,184,.2); }

/* Detail panel */
.arc-layout { display:grid; grid-template-columns:minmax(0,1fr); gap:16px; min-width:0; }
.arc-layout > * { min-width:0; }
.arc-layout.with-detail { grid-template-columns:minmax(0,1fr); }
.arc-detail { background:var(--a-surface); border:1px solid var(--a-border); border-radius:12px;
               padding:22px; min-width:0; width:100%; min-height:100%;
               overflow:hidden; box-sizing:border-box; }
.arc-laserfiche-link { flex-shrink:0; font-size:.7rem; padding:5px 8px; border:1px solid var(--a-border); border-radius:6px; background:#eff6ff; color:#2563eb; }
.arc-detail-title { color:var(--a-text); font-size:.9rem; font-weight:600; margin-bottom:14px;
                     padding-bottom:10px; border-bottom:1px solid var(--a-border);
                     display:flex; align-items:center; justify-content:space-between; }
.arc-detail-close { background:none; border:none; color:var(--a-muted); cursor:pointer; font-size:1.1rem; padding:0 2px; }
.arc-detail-close:hover { color:var(--a-text); }

/* Empty state */
.arc-empty { display:flex; flex-direction:column; align-items:center; justify-content:center;
              padding:48px 24px; color:var(--a-muted); gap:10px; text-align:center; }
.arc-empty-icon { opacity:.3; }
.arc-empty-text { font-size:.85rem; }

/* Alert */
.arc-alert { background:rgba(239,68,68,.08); border:1px solid rgba(239,68,68,.25); border-radius:10px;
              padding:12px 16px; color:#b91c1c; font-size:.83rem; display:flex; align-items:flex-start; gap:10px; }

/* Loading spinner */
.arc-loading { display:flex; align-items:center; justify-content:center; padding:48px; color:var(--a-muted); gap:10px; font-size:.83rem; }
@@keyframes spin { to { transform:rotate(360deg); } }
.arc-spinner { width:20px; height:20px; border:2px solid var(--a-border); border-top-color:var(--a-accent);
                border-radius:50%; animation:spin .7s linear infinite; }

@@media(max-width:900px){ .arc-layout.with-detail { grid-template-columns:1fr; } }
#arcDetailPanel { position:fixed; inset:0; z-index:1050; background:rgba(15,23,42,.3); }
#arcDetailInner { position:absolute; inset-block:0; inset-inline-end:0; width:min(440px,94vw);
                  overflow:auto; border-radius:18px 0 0 18px; box-shadow:0 12px 40px rgba(15,23,42,.18); }
.arc-card { overflow-x:auto; }
.arc-tbl { min-width:900px; }
.arc-tbl td:last-child { white-space:nowrap; min-width:130px; }
.arc-tbl th { text-align:start; background:#f8faff; }
.arc-tbl td { line-height:1.6; }
.arc-name a { overflow-wrap:anywhere; }
.arc-page-input { appearance:textfield; -moz-appearance:textfield; }
.arc-page-input::-webkit-inner-spin-button, .arc-page-input::-webkit-outer-spin-button { -webkit-appearance:none; margin:0; }
.arc-page-total { color:var(--a-muted); font-size:.78rem; white-space:nowrap; }
[dir="rtl"] #arcDetailInner { border-radius:0 18px 18px 0; }
</style>
}

<div style="color:var(--a-text)">

<!-- ── Header ─────────────────────────────────────────────────────────────── -->
<div class="arc-header">
    <div>
        <h1 class="arc-title">🗂️ @L["DocumentArchive"]</h1>
        <p class="arc-sub">@(Model.IsDrillDown ? Model.DrillDownDescription : L["BrowseRepository"].Value)</p>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
        @if (Model.IsDrillDown && !string.IsNullOrWhiteSpace(Model.LaserficheWebClientUrl))
        {
            <a class="arc-open-lf" href="@Model.LaserficheWebClientUrl" target="_blank" rel="noopener">
                Open in Laserfiche
            </a>
        }
        <span style="font-size:.75rem;color:var(--a-muted)">
            @if (templates.Count > 0)
            {
                <text>@templates.Count template@(templates.Count == 1 ? "" : "s")</text>
            }
            else
            {
                <text>@(Model.IsDrillDown ? Model.TotalCount : Model.Entries.Count) entr@((Model.IsDrillDown ? Model.TotalCount : Model.Entries.Count) == 1 ? "y" : "ies") ·
                @folders.Count folder@(folders.Count == 1 ? "" : "s") ·
                @documents.Count doc@(documents.Count == 1 ? "" : "s")</text>
            }
        </span>
    </div>
</div>

<!-- ── Connection error ───────────────────────────────────────────────────── -->
@if (!Model.IsConnected || !string.IsNullOrWhiteSpace(Model.ErrorMessage) && Model.Entries.Count == 0)
{
    <div class="arc-alert" style="margin-bottom:16px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@(Model.ErrorMessage ?? "Not connected to Laserfiche. Please check Settings.")</span>
    </div>
}

<!-- ── Breadcrumb ─────────────────────────────────────────────────────────── -->
<div class="arc-crumb">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--a-muted)" stroke-width="2" style="flex-shrink:0"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
    @if (Model.IsDrillDown)
    {
        <a href="/Archive">Repository</a>
        <span class="arc-crumb-sep">›</span>
        <span class="arc-crumb-cur">@Model.DrillDownTitle</span>
    }
    else
    {
        @for (var i = 0; i < Model.Breadcrumb.Count; i++)
        {
            var crumb = Model.Breadcrumb[i];
            <a href="/Archive?entryId=@crumb.EntryId&trail=@Uri.EscapeDataString(crumb.Trail)">@crumb.Name</a>
            <span class="arc-crumb-sep">›</span>
        }
        <span class="arc-crumb-cur">@Model.CurrentName</span>
    }
</div>

<!-- ── Layout: table + detail panel ─────────────────────────────────────────── -->
<div class="arc-layout" id="arcLayout">

    <!-- Entry table -->
    <div>
        <!-- Toolbar -->
        <div class="arc-toolbar">
            <input id="arcFilter" class="arc-filter" type="text"
                   placeholder="@L["FilterCurrentFolder"]" autocomplete="off" />
            <span class="arc-count" id="arcCount">
                @(templates.Count > 0 ? templates.Count : Model.Entries.Count)
                @(templates.Count > 0 ? (templates.Count == 1 ? "template" : "templates") : (Model.Entries.Count == 1 ? "entry" : "entries"))
            </span>
        </div>

        <!-- Error bar when folder loaded but had a problem -->
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) && Model.Entries.Count > 0)
        {
            <div class="arc-alert" style="margin-bottom:12px">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <div class="arc-card">
            @if (Model.IsConnected && Model.Entries.Count == 0 && templates.Count == 0 && string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="arc-empty">
                    <svg class="arc-empty-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span class="arc-empty-text">@L["ThisFolderIsEmpty"]</span>
                </div>
            }
            else if (templates.Count > 0)
            {
                <table class="arc-tbl" id="arcTable">
                    <thead>
                        <tr>
                            <th data-col="name" class="sorted" style="min-width:220px">@L["Template"] <span class="sort-icon">▲</span></th>
                            <th data-col="type" style="width:110px">@L["Type"] <span class="sort-icon">⇅</span></th>
                            <th data-col="created" style="width:130px">@L["Documents"] <span class="sort-icon">⇅</span></th>
                            <th data-col="template">Description <span class="sort-icon">⇅</span></th>
                        </tr>
                    </thead>
                    <tbody id="arcTbody">
                    @foreach (var template in templates)
                    {
                        <tr data-type="template"
                            data-name="@template.Name.ToLower()"
                            data-template="@(template.Description?.ToLower() ?? string.Empty)"
                            data-creator=""
                            data-created="@template.DocumentCount"
                            data-modified="0">
                            <td>
                                <div class="arc-name">
                                    <svg class="arc-icon" width="15" height="17" viewBox="0 0 24 24" fill="#8b5cf6" stroke="#7c3aed" stroke-width="1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="#6d28d9" stroke-width="1.5"/></svg>
                                    <a href="@Url.Action("Index", "Archive", new { scope = "template", template = template.Name })">@template.Name</a>
                                </div>
                            </td>
                            <td><span class="arc-badge arc-badge-other">Template</span></td>
                            <td style="color:var(--a-muted)">
                                <a href="@Url.Action("Index", "Archive", new { scope = "template", template = template.Name })">@template.DocumentCount</a>
                            </td>
                            <td style="color:var(--a-muted)">@(template.Description ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else if (Model.Entries.Count > 0)
            {
                <table class="arc-tbl" id="arcTable">
                    <thead>
                        <tr>
                            <th data-col="name"     class="sorted" style="min-width:220px">@L["Name"] <span class="sort-icon">▲</span></th>
                            <th data-col="type"     style="width:100px">@L["Type"] <span class="sort-icon">⇅</span></th>
                            <th data-col="template" style="width:160px">@L["Template"] <span class="sort-icon">⇅</span></th>
                            <th data-col="created"  style="width:130px">@L["Created"] <span class="sort-icon">⇅</span></th>
                            <th data-col="modified" style="width:130px">@L["Modified"] <span class="sort-icon">⇅</span></th>
                            <th data-col="creator"  style="width:130px">@L["CreatedBy"] <span class="sort-icon">⇅</span></th>
                        </tr>
                    </thead>
                    <tbody id="arcTbody">
                        @foreach (var entry in Model.Entries)
                        {
                            var isFolder   = entry.EntryType == LFEntryType.Folder;
                            var typeLabel  = entry.EntryType switch {
                                LFEntryType.Folder   => "Folder",
                                LFEntryType.Document => "Document",
                                LFEntryType.Shortcut => "Shortcut",
                                _ => "Other"
                            };
                            var badgeClass = entry.EntryType switch {
                                LFEntryType.Folder   => "arc-badge-folder",
                                LFEntryType.Document => "arc-badge-document",
                                LFEntryType.Shortcut => "arc-badge-shortcut",
                                _ => "arc-badge-other"
                            };
                            var folderUrl = Model.IsDrillDown
                                ? Url.Action("Index", "Archive", new { entryId = entry.Id })
                                : Url.Action("Index", "Archive", new { entryId = entry.Id, trail = childTrail });

                            <tr data-type="@typeLabel.ToLower()"
                                data-name="@entry.Name.ToLower()"
                                data-template="@(entry.TemplateName?.ToLower() ?? "")"
                                data-creator="@(entry.Creator?.ToLower() ?? "")"
                                data-created="@(entry.CreationTime?.Ticks ?? 0)"
                                data-modified="@(entry.LastModifiedTime?.Ticks ?? entry.CreationTime?.Ticks ?? 0)">

                                <!-- Name -->
                                <td>
                                    <div class="arc-name @(isFolder ? "arc-name-folder" : "")">
                                        @if (isFolder)
                                        {
                                            <!-- Folder icon -->
                                            <svg class="arc-icon" width="17" height="17" viewBox="0 0 24 24" fill="#f59e0b" stroke="#d97706" stroke-width="1"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                            <a href="@folderUrl"
                                               title="Open folder: @entry.Name">@entry.Name</a>
                                            @if (!string.IsNullOrWhiteSpace(Model.LaserficheWebClientEntryUrlPrefix))
                                            {
                                                <a href="@(Model.LaserficheWebClientEntryUrlPrefix + entry.Id + ";view=browse")"
                                                   class="arc-laserfiche-link" target="_blank" rel="noopener" title="Open in Laserfiche">فتح في Laserfiche ↗</a>
                                            }
                                        }
                                        else
                                        {
                                            <!-- Document icon -->
                                            <svg class="arc-icon" width="15" height="17" viewBox="0 0 24 24" fill="#3b82f6" stroke="#2563eb" stroke-width="1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="#1d4ed8" stroke-width="1.5"/></svg>
                                            <a href="#" class="arc-doc-link" data-entry-id="@entry.Id"
                                               title="View document details: @entry.Name">@entry.Name</a>
                                            @if (!string.IsNullOrWhiteSpace(Model.LaserficheWebClientEntryUrlPrefix))
                                            {
                                                <a href="@(Model.LaserficheWebClientEntryUrlPrefix + entry.Id + ";view=pages")"
                                                   class="arc-laserfiche-link" target="_blank" rel="noopener" title="Open in Laserfiche">فتح في Laserfiche ↗</a>
                                            }
                                        }
                                    </div>
                                </td>

                                <!-- Type -->
                                <td><span class="arc-badge @badgeClass">@typeLabel</span></td>

                                <!-- Template -->
                                <td style="color:var(--a-muted)">@(entry.TemplateName ?? "—")</td>

                                <!-- Created -->
                                <td style="color:var(--a-muted);white-space:nowrap">@FmtDate(entry.CreationTime)</td>

                                <!-- Modified -->
                                <td style="color:var(--a-muted);white-space:nowrap">@FmtAgo(entry.LastModifiedTime ?? entry.CreationTime)</td>

                                <!-- Created By -->
                                <td style="color:var(--a-muted)">@(entry.Creator ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (Model.IsDrillDown && Model.TotalPages > 1)
            {
                <nav class="arc-pager" aria-label="Archive result pages">
                    <a class="arc-page @(Model.PageNumber <= 1 ? "disabled" : "")" href="@BuildPageUrl(Model.PageNumber - 1)">@L["Previous"]</a>
                    @for (var pageNumber = pageWindowStart; pageNumber <= pageWindowEnd; pageNumber++)
                    {
                        <a class="arc-page @(pageNumber == Model.PageNumber ? "active" : "")" href="@BuildPageUrl(pageNumber)">@pageNumber</a>
                    }
                    <a class="arc-page @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")" href="@BuildPageUrl(Model.PageNumber + 1)">@L["Next"]</a>
                    <label for="archivePageInput" style="color:var(--a-muted);font-size:.76rem">Page</label>
                    <input id="archivePageInput" class="arc-page-input" type="number" min="1" max="@Model.TotalPages" value="@Model.PageNumber" />
                    <span class="arc-page-total">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "إجمالي الصفحات:" : "Total pages:") @Model.TotalPages</span>
                    <button id="archivePageGo" class="arc-page" type="button">Go</button>
                </nav>
            }
        </div>
    </div>

    <!-- Detail panel (hidden until a document is clicked) -->
    <div id="arcDetailPanel" style="display:none" role="dialog" aria-modal="true" aria-label="@L["EntryInformation"]" tabindex="-1">
        <div class="arc-detail" id="arcDetailInner">
            <div class="arc-loading">
                <div class="arc-spinner"></div>
                Loading…
            </div>
        </div>
    </div>

</div><!-- end arc-layout -->
</div><!-- end outer -->

@section Scripts {
<script src="~/js/document-preview.js" asp-append-version="true"></script>
<script>
(function () {
    // ── Filter ──────────────────────────────────────────────────────────────
    const filterInput = document.getElementById('arcFilter');
    const tbody       = document.getElementById('arcTbody');
    const countEl     = document.getElementById('arcCount');

    function applyFilter() {
        if (!tbody) return;
        const q = filterInput.value.trim().toLowerCase();
        let visible = 0;
        const rows = tbody.querySelectorAll('tr');
        rows.forEach(row => {
            const name     = row.dataset.name     || '';
            const template = row.dataset.template || '';
            const creator  = row.dataset.creator  || '';
            const type     = row.dataset.type     || '';
            const match = !q ||
                name.includes(q) || template.includes(q) ||
                creator.includes(q) || type.includes(q);
            row.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        if (countEl) countEl.textContent =
            visible + (visible === 1 ? ' entry' : ' entries') +
            (q ? ' (filtered)' : '');
    }

    if (filterInput) filterInput.addEventListener('input', applyFilter);

    // ── Column sort ──────────────────────────────────────────────────────────
    let sortCol = 'name', sortAsc = true;

    const tbl = document.getElementById('arcTable');
    if (tbl) {
        tbl.querySelectorAll('th[data-col]').forEach(th => {
            th.addEventListener('click', () => {
                const col = th.dataset.col;
                if (col === sortCol) {
                    sortAsc = !sortAsc;
                } else {
                    sortCol = col;
                    sortAsc = true;
                }
                // Update header indicators
                tbl.querySelectorAll('th[data-col]').forEach(h => {
                    h.classList.remove('sorted');
                    h.querySelector('.sort-icon').textContent = '⇅';
                });
                th.classList.add('sorted');
                th.querySelector('.sort-icon').textContent = sortAsc ? '▲' : '▼';

                sortTable();
            });
        });
    }

    function sortTable() {
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort((a, b) => {
            let va, vb;
            if (sortCol === 'name')     { va = a.dataset.name;     vb = b.dataset.name; }
            if (sortCol === 'type')     { va = a.dataset.type;     vb = b.dataset.type; }
            if (sortCol === 'template') { va = a.dataset.template; vb = b.dataset.template; }
            if (sortCol === 'creator')  { va = a.dataset.creator;  vb = b.dataset.creator; }
            if (sortCol === 'created')  { va = parseInt(a.dataset.created  || '0'); vb = parseInt(b.dataset.created  || '0'); }
            if (sortCol === 'modified') { va = parseInt(a.dataset.modified || '0'); vb = parseInt(b.dataset.modified || '0'); }

            let cmp;
            if (typeof va === 'number') {
                cmp = va - vb;
            } else {
                // Folders always first when sorting by name or type
                if (sortCol === 'name' || sortCol === 'type') {
                    const aIsFolder = a.dataset.type === 'folder' ? 0 : 1;
                    const bIsFolder = b.dataset.type === 'folder' ? 0 : 1;
                    if (aIsFolder !== bIsFolder) return sortAsc ? aIsFolder - bIsFolder : bIsFolder - aIsFolder;
                }
                cmp = (va || '').localeCompare(vb || '', undefined, { sensitivity: 'base' });
            }
            return sortAsc ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
    }

    // ── Document detail panel ────────────────────────────────────────────────
    const layout      = document.getElementById('arcLayout');
    const detailPanel = document.getElementById('arcDetailPanel');
    const detailInner = document.getElementById('arcDetailInner');

    const detailUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Detail", "Archive")));
    let detailRequest;
    let selectedLink;
    function closeDetail() {
        detailRequest?.abort();
        detailPanel.style.display = 'none';
        document.body.style.overflow = '';
        selectedLink?.focus();
    }
    async function openDocumentDetail(entryId, link) {
        if (!entryId) return;
        detailRequest?.abort();
        const request = new AbortController();
        detailRequest = request;
        selectedLink = link;
        detailPanel.style.display = '';
        document.body.style.overflow = 'hidden';
        detailPanel.focus();
        detailInner.innerHTML = '<button class="det-close" id="arcCloseDetail" aria-label="Close">✕</button><div class="arc-loading"><div class="arc-spinner"></div>Loading…</div>';
        try {
            const url = new URL(detailUrl, window.location.origin);
            url.searchParams.set('entryId', entryId);
            const resp = await fetch(url, { signal:request.signal, headers:{'X-Requested-With':'XMLHttpRequest'} });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const html = await resp.text();
            if (request.signal.aborted) return;
            detailInner.innerHTML = html;
            const preview = detailInner.querySelector('[data-preview-url]');
            if (preview) {
                fetch(preview.dataset.previewUrl, { signal:request.signal })
                    .then(response => { if (!response.ok) throw new Error(); return response.text(); })
                    .then(html => {
                        if (request.signal.aborted) return;
                        preview.innerHTML = html;
                        window.loadDocumentPdfPreviews(preview, request.signal);
                        preview.querySelectorAll('img').forEach(img => {
                            img.addEventListener('error', () => {
                                img.hidden = true;
                                preview.querySelector('[data-preview-error]').hidden = false;
                            });
                            if (img.complete && !img.naturalWidth) img.dispatchEvent(new Event('error'));
                        });
                    })
                    .catch(error => { if (error.name !== 'AbortError') preview.textContent = 'تعذر تحميل المعاينة. أعد المحاولة.'; });
            }
            detailInner.querySelectorAll('a.det-action-primary').forEach(action => {
                const target = new URL(action.href);
                target.searchParams.set('returnUrl', window.location.pathname + window.location.search);
                action.href = target.toString();
            });
            detailInner.querySelector('#arcCloseDetail')?.focus();
        } catch (error) {
            if (error.name === 'AbortError') return;
            detailInner.innerHTML = '<button class="det-close" id="arcCloseDetail" aria-label="Close">✕</button><div class="arc-alert">Could not load document details.</div>';
        }
    }
    document.addEventListener('click', event => {
        const link = event.target.closest('.arc-doc-link');
        if (link) { event.preventDefault(); openDocumentDetail(link.dataset.entryId, link); }
        if (event.target === detailPanel || event.target.closest('#arcCloseDetail')) closeDetail();
    });
    document.addEventListener('keydown', event => {
        if (detailPanel.style.display === 'none') return;
        if (event.key === 'Escape') closeDetail();
        if (event.key !== 'Tab') return;
        const items = [...detailInner.querySelectorAll('a[href],button:not(:disabled),input')];
        const first = items[0], last = items[items.length - 1];
        if (!first) { event.preventDefault(); detailPanel.focus(); return; }
        if (event.shiftKey && (document.activeElement === first || document.activeElement === detailPanel)) {
            event.preventDefault(); last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || document.activeElement === detailPanel)) {
            event.preventDefault(); first.focus();
        }
    });

    const initialEntryId = @Model.OpenEntryId;
    if (initialEntryId > 0) openDocumentDetail(initialEntryId.toString());

    const pageInput = document.getElementById('archivePageInput');
    const pageGo = document.getElementById('archivePageGo');
    function goToArchivePage() {
        if (!pageInput) return;
        const max = Number.parseInt(pageInput.max || '1', 10);
        const parsed = Number.parseInt(pageInput.value, 10);
        if (!Number.isFinite(parsed)) return;
        const target = Math.min(max, Math.max(1, parsed));
        const url = new URL(window.location.href);
        url.searchParams.set('page', target.toString());
        window.location.assign(url.toString());
    }
    if (pageGo) pageGo.addEventListener('click', goToArchivePage);
    if (pageInput) pageInput.addEventListener('keydown', event => {
        if (event.key === 'Enter') goToArchivePage();
    });

})();
</script>
}
