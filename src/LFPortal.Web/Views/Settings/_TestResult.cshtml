@model LFPortal.Domain.Entities.ConnectionStatus
@{
    Layout = null; // partial — no layout wrapper
}

@if (Model.IsConnected)
{
    <div class="card" style="border-left:4px solid var(--lfp-green);">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <span style="font-size:1.25rem;color:var(--lfp-green);">&#10003;</span>
            <span style="font-weight:700;color:var(--lfp-text);">Connection Successful</span>
            <span class="badge badge--green" style="margin-left:auto;">Connected</span>
        </div>
        <div class="status-grid">
            <div class="status-item">
                <span class="status-item__label">Repository Name</span>
                <span class="status-item__value">@(Model.RepositoryName ?? "—")</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">Server Version</span>
                <span class="status-item__value">@(Model.ServerVersion ?? "—")</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">API Version</span>
                <span class="status-item__value">@(Model.ApiVersion ?? "—")</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">Tested At</span>
                <span class="status-item__value">@Model.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="card" style="border-left:4px solid var(--lfp-red);">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <span style="font-size:1.25rem;color:var(--lfp-red);">&#10007;</span>
            <span style="font-weight:700;color:var(--lfp-text);">Connection Failed</span>
            <span class="badge badge--red" style="margin-left:auto;">Disconnected</span>
        </div>
        <div class="alert alert--error">
            <span>&#9888;</span>
            <div>@(Model.ErrorMessage ?? "An unknown error occurred.")</div>
        </div>
        <div style="margin-top:12px;font-size:.8125rem;color:var(--lfp-muted);">
            Verify the Server URL, Repository ID, and credentials, then try again.
        </div>
    </div>
}
