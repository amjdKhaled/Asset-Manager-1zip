@model LFPortal.Web.Controllers.SettingsViewModel
@using LFPortal.Domain.Entities
@{
    ViewData["Title"] = "Settings";
    var connected = Model.ConnectionStatus?.IsConnected ?? false;
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
    <h1 style="font-size:1.5rem;font-weight:700;color:var(--lfp-text);">&#9881;&#65039; @L["Settings"]</h1>
</div>

@* ── Success / error banners ───────────────────────────────────────────── *@
@if (Model.SaveSuccess)
{
    <div class="alert alert--success" style="margin-bottom:16px;">
        <span>&#10003;</span>
        <div>
            <strong>@L["SettingsSaved"]</strong>
            All Laserfiche services are now using the updated configuration.
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert--error" style="margin-bottom:16px;">
        <span>&#9888;</span>
        <div><strong>@L["SettingsFailed"]</strong> @Model.ErrorMessage</div>
    </div>
}

@* ── Desktop Client login-flow notice ─────────────────────────────────── *@
<div class="alert alert--info" style="margin-bottom:16px;">
    <span>&#128187;</span>
    <div>
        <strong>Desktop Client sessions use the Login screen.</strong>
        When Dashboard is opened from the Laserfiche Desktop Client, users are prompted to
        sign in on the <strong>Login page</strong> for each repository.
        No Settings credentials are required for that flow.
        The credentials below are <strong>fallback / admin credentials</strong> — they are used only
        when Dashboard is opened directly in a browser (without the Desktop Client).
    </div>
</div>

@* ── Credential status banner ──────────────────────────────────────────── *@
@if (Model.HasSavedCredentials)
{
    <div class="alert alert--info" style="margin-bottom:16px;">
        <span>&#128274;</span>
        <div>
            <strong>Fallback credentials saved.</strong>
            These are used for direct browser access only. Leave Username and Password blank to keep them unchanged.
        </div>
    </div>
}
else if (Model.HasEnvironmentVariableCredentials)
{
    <div class="alert alert--amber" style="margin-bottom:16px;">
        <span>&#8505;</span>
        <div>
            <strong>Using environment variable fallback credentials</strong> (<code>LF_USERNAME</code> / <code>LF_PASSWORD</code>).
            Save credentials here to switch to persistent secure storage (used for direct browser access only).
        </div>
    </div>
}
else
{
    <div class="alert alert--error" style="margin-bottom:16px;">
        <span>&#9888;</span>
        <div>
            <strong>No fallback credentials configured.</strong>
            Enter a username and password below to enable direct browser access.
            Desktop Client sessions use the Login page and do not require these credentials.
        </div>
    </div>
}

@* ── Connection Status section ─────────────────────────────────────────── *@
@if (Model.ConnectionStatus != null)
{
    <div class="card" style="margin-bottom:16px;">
        <div class="card__title" style="display:flex;align-items:center;justify-content:space-between;">
            <span>@L["ConnectionStatus"]</span>
            @if (connected)
            {
                <span class="badge badge--green">@L["Connected"]</span>
            }
            else
            {
                <span class="badge badge--red">@L["Disconnected"]</span>
            }
        </div>

        @if (!connected && !string.IsNullOrWhiteSpace(Model.ConnectionStatus.ErrorMessage))
        {
            <div class="alert alert--error" style="margin-bottom:16px;">
                <span>&#9888;</span>
                <div>
                    <strong>Connection failed:</strong>
                    @Model.ConnectionStatus.ErrorMessage
                </div>
            </div>
        }

        <div class="status-grid">
            <div class="status-item">
                <span class="status-item__label">@L["ActiveRepository"]</span>
                <span class="status-item__value">@(Model.ConnectionStatus.RepositoryId ?? Model.EffectiveRepositoryId)</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">@L["RepositoryName"]</span>
                <span class="status-item__value">@(Model.ConnectionStatus.RepositoryName ?? "—")</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">@L["ServerVersion"]</span>
                <span class="status-item__value">@(Model.ConnectionStatus.ServerVersion ?? "—")</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">API Version</span>
                <span class="status-item__value">@(Model.ConnectionStatus.ApiVersion ?? "—")</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">@L["LastChecked"]</span>
                <span class="status-item__value">@Model.ConnectionStatus.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            </div>
            <div class="status-item">
                <span class="status-item__label">@L["LaunchSource"]</span>
                <span class="status-item__value">
                    @if (Model.EffectiveRepositorySource == "Laserfiche Desktop Client")
                    {
                        <span class="badge badge--blue" style="font-size:.75rem;">&#128187; Laserfiche Desktop Client</span>
                    }
                    else if (Model.EffectiveRepositorySource == "Laserfiche Web Client")
                    {
                        <span class="badge badge--green" style="font-size:.75rem;">&#127760; Laserfiche Web Client</span>
                    }
                    else
                    {
                        <span class="badge badge--gray" style="font-size:.75rem;">&#9881; Default / Direct</span>
                    }
                </span>
            </div>
        </div>
    </div>
}

@* ── Settings form ─────────────────────────────────────────────────────── *@
<div class="card">
    <div class="card__title">@L["LaserficheConnection"]</div>

    <form id="settings-form" method="post" asp-controller="Settings" asp-action="Save" novalidate>
        @Html.AntiForgeryToken()

        @* ── API Version ─────────────────────────────────────────────── *@
        <div class="form-section">
            <div class="form-section__title">@L["ApiVersion"]</div>
            <div class="settings-grid">
                <div class="field-group">
                    <label class="field-label" for="ApiVersion">Laserfiche API Version</label>
                    <select class="field-input" id="ApiVersion" name="ApiVersion">
                        @{
                            var isAuto = Model.IsAutoApiVersion;
                            var isV1   = !isAuto && string.Equals(Model.ApiVersion?.Trim(), "v1", StringComparison.OrdinalIgnoreCase);
                            var isV2   = !isAuto && string.Equals(Model.ApiVersion?.Trim(), "v2", StringComparison.OrdinalIgnoreCase);
                        }
                        <option value="Auto" selected="@isAuto">Auto Detect (recommended)</option>
                        <option value="v1" selected="@isV1">v1</option>
                        <option value="v2" selected="@isV2">v2</option>
                    </select>
                    <span class="field-hint">
                        Auto Detect probes the server (v2 first, then v1) and remembers the result.
                        @if (Model.IsAutoApiVersion)
                        {
                            if (!string.IsNullOrWhiteSpace(Model.DetectedApiVersion))
                            {
                                <text>Currently detected: <strong>@Model.DetectedApiVersion</strong>.</text>
                            }
                            else
                            {
                                <text>Detection pending — using <strong>@Model.EffectiveApiVersion</strong> until the server responds.</text>
                            }
                        }
                    </span>
                </div>
            </div>
        </div>

        @* ── Repository ─────────────────────────────────────────────── *@
        <div class="form-section">
            <div class="form-section__title">@L["Repository"]</div>
            <div class="settings-grid">
                <div class="field-group" style="grid-column: span 2;">
                    <label class="field-label" for="ServerUrl">@L["ApiServerUrl"]</label>
                    <input class="field-input" type="text" id="ServerUrl" name="ServerUrl"
                           value="@Model.ServerUrl"
                           placeholder="https://lf-server.corp.local"
                           autocomplete="off" />
                    <span class="field-hint">
                        Base URL of your Laserfiche API Server — scheme and host only, e.g.
                        <code>https://lf-server.corp.local</code>.
                        Do <strong>not</strong> include <code>/LFRepositoryAPI</code> or a version here;
                        use the Advanced fields below. If you paste a full URL the portal will parse it automatically.
                    </span>
                </div>
                <div class="field-group">
                    <label class="field-label" for="RepositoryId">
                        @L["DefaultRepository"]
                        <button type="button" id="discover-btn" class="btn btn--secondary"
                                style="margin-left:8px;padding:3px 10px;font-size:.75rem;">
                            &#128269; Discover
                        </button>
                    </label>
                    <input class="field-input" type="text" id="RepositoryId" name="RepositoryId"
                           value="@Model.RepositoryId"
                           placeholder="Documents"
                           autocomplete="off" />
                    <span id="discover-status" class="field-hint"></span>
                    <span class="field-hint">
                        Used when Dashboard is opened directly from a browser.
                        When opened via the <strong>Laserfiche Desktop Client</strong>, the client's active
                        repository overrides this setting automatically.
                        Case-sensitive; must match the repository name in the Laserfiche Admin Console.
                    </span>
                </div>
                <div class="field-group">
                    <label class="field-label" for="DisplayName">
                        @L["DisplayName"]
                        <span style="font-weight:400;color:var(--lfp-muted);">@L["Optional"]</span>
                    </label>
                    <input class="field-input" type="text" id="DisplayName" name="DisplayName"
                           value="@Model.DisplayName"
                           placeholder="Documents Repository"
                           autocomplete="off" />
                    <span class="field-hint">Label shown in the portal UI. Defaults to Repository ID if blank.</span>
                </div>
            </div>
        </div>

        @* ── Browse settings ──────────────────────────────────────────── *@
        <div class="form-section" style="margin-top:24px;">
            <div class="form-section__title">@L["BrowseSettings"]</div>
            <div class="settings-grid">
                <div class="field-group">
                    <label class="field-label" for="RootEntryId">@L["RootEntryId"]</label>
                    <input class="field-input" type="number" id="RootEntryId" name="RootEntryId"
                           value="@Model.RootEntryId" min="1" />
                    <span class="field-hint">
                        Entry ID of the root folder to browse. Default is <strong>1</strong>.
                        Change this if your repository root is not ID 1 (check the Laserfiche Admin Console).
                    </span>
                </div>
                <div class="field-group">
                    <label class="field-label" for="TimeoutSeconds">@L["ApiTimeout"]</label>
                    <input class="field-input" type="number" id="TimeoutSeconds" name="TimeoutSeconds"
                           value="@Model.TimeoutSeconds" min="5" max="300" />
                    <span class="field-hint">
                        HTTP request timeout for all Laserfiche API calls. Default is <strong>30</strong>.
                        Increase for slow networks or large document downloads (max 300).
                    </span>
                </div>
            </div>
        </div>

        @* ── Advanced ────────────────────────────────────────────────── *@
        <div class="form-section" style="margin-top:24px;">
            <details>
                <summary class="form-section__title" style="cursor:pointer;user-select:none;list-style:none;display:flex;align-items:center;gap:6px;">
                    <span id="adv-chevron" style="font-size:.75rem;transition:transform .2s;">&#9654;</span>
                    Advanced — API path
                </summary>
                <div class="settings-grid" style="margin-top:16px;">
                    <div class="field-group">
                        <label class="field-label" for="ApiBasePath">API Base Path</label>
                        <input class="field-input" type="text" id="ApiBasePath" name="ApiBasePath"
                               value="@Model.ApiBasePath"
                               placeholder="/LFRepositoryAPI"
                               autocomplete="off" />
                        <span class="field-hint">
                            Virtual directory where the Laserfiche API Server is installed.
                            Default: <code>/LFRepositoryAPI</code>.
                        </span>
                    </div>
                </div>
            </details>
        </div>

        @* ── Credentials ─────────────────────────────────────────────── *@
        <div class="form-section" style="margin-top:24px;">
            <div class="form-section__title">@L["Credentials"]</div>
            <div class="settings-grid">
                <div class="field-group">
                    <label class="field-label" for="Username">@L["Username"]</label>
                    <input class="field-input" type="text" id="Username" name="Username"
                           placeholder="@(Model.HasSavedCredentials ? "Leave blank to keep saved credentials" : "laserfiche-admin")"
                           autocomplete="username" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="Password">@L["Password"]</label>
                    <input class="field-input" type="password" id="Password" name="Password"
                           placeholder="@(Model.HasSavedCredentials ? "Leave blank to keep saved credentials" : "Enter password")"
                           autocomplete="current-password" />
                    <span class="field-hint">
                        Stored securely using
                        @(OperatingSystem.IsWindows() ? "Windows DPAPI (machine-encrypted)" : "ASP.NET Core Data Protection").
                        Never written to configuration files.
                    </span>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;flex-wrap:wrap;">
            <button type="submit" class="btn btn--primary">
                &#128190; @L["SaveSettings"]
            </button>
            <button type="button" id="test-btn" class="btn btn--secondary">
                &#128268; @L["TestConnection"]
            </button>
        </div>
    </form>
</div>

@* ── Inline test result (injected by JS) ───────────────────────────────── *@
<div id="test-result" style="margin-top:16px;"></div>

@* ── Quick-reference card ──────────────────────────────────────────────── *@
<div class="card" style="margin-top:16px;">
    <div class="card__title">@L["ConfigReference"]</div>
    <div class="status-grid">
        <div class="status-item">
            <span class="status-item__label">Token URL (current)</span>
            <span class="status-item__value" style="font-family:monospace;font-size:.75rem;word-break:break-all;">
                @($"{Model.ServerUrl.TrimEnd('/')}{Model.ApiBasePath}/{Model.EffectiveApiVersion}/Repositories/{(string.IsNullOrWhiteSpace(Model.EffectiveRepositoryId) ? "{RepositoryId}" : Model.EffectiveRepositoryId)}/Token")
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">Repository List URL (current)</span>
            <span class="status-item__value" style="font-family:monospace;font-size:.75rem;word-break:break-all;">
                @($"{Model.ServerUrl.TrimEnd('/')}{Model.ApiBasePath}/{Model.EffectiveApiVersion}/Repositories")
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">API Version</span>
            <span class="status-item__value">
                @Model.EffectiveApiVersion@(Model.IsAutoApiVersion ? " (auto-detected)" : " (pinned)")
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">Root Entry ID</span>
            <span class="status-item__value" style="font-family:monospace;">@Model.RootEntryId</span>
        </div>
        <div class="status-item">
            <span class="status-item__label">API Timeout</span>
            <span class="status-item__value">@Model.TimeoutSeconds s</span>
        </div>
        <div class="status-item">
            <span class="status-item__label">Credential Store</span>
            <span class="status-item__value">
                @(OperatingSystem.IsWindows() ? "DPAPI (Windows, machine-scoped)" : "ASP.NET Core Data Protection")
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">Env Var Fallback</span>
            <span class="status-item__value">
                @if (Model.HasEnvironmentVariableCredentials)
                {
                    <span class="badge badge--amber">Active</span>
                }
                else
                {
                    <span style="color:var(--lfp-muted);">Not set</span>
                }
            </span>
        </div>
    </div>
</div>

@* ── SSO / LFDS Configuration Reference ──────────────────────────────────── *@
<div class="card" style="margin-top:16px;">
    <div class="card__title" style="display:flex;align-items:center;justify-content:space-between;">
        <span>SSO / LFDS Configuration Reference</span>
        @if (Model.SsoEnabled)
        {
            <span class="badge badge--green">SSO Enabled</span>
        }
        else
        {
            <span class="badge" style="background:#e5e7eb;color:#6b7280;border:1px solid #d1d5db;">SSO Disabled</span>
        }
    </div>

    @if (!Model.SsoEnabled)
    {
        <p style="font-size:.85rem;color:#6b7280;margin-bottom:16px;">
            SSO is dormant. Set <code>Laserfiche:Sso:LfdsBaseUrl</code> in
            <code>%ProgramData%\Dashboard\laserfiche.config.json</code> to activate it.
            Until then users sign in with username and password — no other behaviour changes.
        </p>
    }
    else
    {
        <div class="alert alert--info" style="margin-bottom:16px;">
            <span>&#8505;</span>
            <div>
                Register the <strong>Callback URL</strong> below in LFDS
                (<code>WhitelistedRedirectUris</code>) and on the Laserfiche API Server
                (<code>LFDSSTSBaseUrl</code>) before enabling SSO.
                The <strong>Client ID</strong> must match on both sides.
            </div>
        </div>
    }

    <div class="status-grid">
        <div class="status-item">
            <span class="status-item__label">SSO Status</span>
            <span class="status-item__value">
                @(Model.SsoEnabled ? "Enabled — LFDS OAuth2 Authorization Code flow active" : "Disabled — username/password login")
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">LFDS Base URL</span>
            <span class="status-item__value" style="font-family:monospace;font-size:.75rem;word-break:break-all;">
                @(string.IsNullOrWhiteSpace(Model.SsoLfdsBaseUrl) ? "(not configured)" : Model.SsoLfdsBaseUrl)
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">OAuth Client ID</span>
            <span class="status-item__value" style="font-family:monospace;">
                @Model.SsoClientId
            </span>
        </div>
        <div class="status-item">
            <span class="status-item__label">Callback URL (register in LFDS)</span>
            <span class="status-item__value" style="font-family:monospace;font-size:.75rem;word-break:break-all;">
                @Model.SsoCallbackUrl
            </span>
        </div>
        @if (Model.SsoEnabled)
        {
            <div class="status-item">
                <span class="status-item__label">Authorization Endpoint</span>
                <span class="status-item__value" style="font-family:monospace;font-size:.75rem;word-break:break-all;">
                    @Model.SsoAuthorizationEndpoint
                </span>
            </div>
            <div class="status-item">
                <span class="status-item__label">SSO Token Endpoint (V2)</span>
                <span class="status-item__value" style="font-family:monospace;font-size:.75rem;word-break:break-all;">
                    @($"{Model.ServerUrl.TrimEnd('/')}{Model.ApiBasePath}/v2/Repositories/{{RepositoryId}}/Token")
                </span>
            </div>
        }
    </div>
</div>

@* ── API diagnostic endpoints (shown when connected) ────────────────────── *@
@if (Model.ConnectionStatus?.IsConnected == true)
{
    <div class="card" style="margin-top:16px;">
        <div class="card__title">API Diagnostic Endpoints</div>
        <div class="alert alert--info">
            <span>&#8505;</span>
            <div>
                Use these endpoints for monitoring, IIS health probes, and integration verification.
                <ul style="margin-top:8px;padding-left:16px;display:flex;flex-direction:column;gap:4px;">
                    <li><code style="background:#dbeafe;padding:1px 6px;border-radius:3px;">/health</code> — ASP.NET Core health check (JSON)</li>
                    <li><code style="background:#dbeafe;padding:1px 6px;border-radius:3px;">/api/laserfiche/status</code> — Live Laserfiche connection status (JSON)</li>
                    <li><code style="background:#dbeafe;padding:1px 6px;border-radius:3px;">/api/laserfiche/repository</code> — Active repository descriptor (JSON)</li>
                </ul>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    // Chevron animation for <details>
    var details = document.querySelector('details');
    var chevron = document.getElementById('adv-chevron');
    if (details && chevron) {
        details.addEventListener('toggle', function() {
            chevron.style.transform = details.open ? 'rotate(90deg)' : '';
        });
    }

    // ── Test Connection ──────────────────────────────────────────────────
    var testBtn  = document.getElementById('test-btn');
    var resultEl = document.getElementById('test-result');
    var form     = document.getElementById('settings-form');

    testBtn.addEventListener('click', async function () {
        testBtn.disabled = true;
        testBtn.textContent = 'Testing\u2026';
        resultEl.innerHTML  = '<div class="alert alert--info"><span>\u2139</span><div>Connecting to Laserfiche\u2026</div></div>';

        try {
            var data  = new FormData(form);
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            var resp = await fetch('/Settings/TestConnection', {
                method:  'POST',
                body:    data,
                headers: { 'RequestVerificationToken': token }
            });

            resultEl.innerHTML = await resp.text();
        } catch (err) {
            resultEl.innerHTML =
                '<div class="alert alert--error"><span>\u26a0</span>' +
                '<div><strong>Request failed:</strong> ' + err.message + '</div></div>';
        } finally {
            testBtn.disabled    = false;
            testBtn.textContent = '\uD83D\uDD0C Test Connection';
        }
    });

    // ── Discover Repositories ────────────────────────────────────────────
    var discoverBtn    = document.getElementById('discover-btn');
    var repoInput      = document.getElementById('RepositoryId');
    var discoverStatus = document.getElementById('discover-status');

    discoverBtn.addEventListener('click', async function () {
        discoverBtn.disabled = true;
        discoverBtn.textContent = 'Discovering\u2026';
        discoverStatus.textContent = '';
        discoverStatus.style.color = '';

        try {
            var data  = new FormData();
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            data.append('__RequestVerificationToken', token);
            data.append('ServerUrl',    document.getElementById('ServerUrl').value);
            data.append('ApiBasePath',  document.getElementById('ApiBasePath').value);
            data.append('RepositoryId', repoInput.value);
            data.append('Username',     document.getElementById('Username').value);
            data.append('Password',     document.getElementById('Password').value);

            var resp = await fetch('/Settings/DiscoverRepositories', {
                method:  'POST',
                body:    data,
                headers: { 'RequestVerificationToken': token }
            });

            var json = await resp.json();

            if (json.error) {
                discoverStatus.textContent = '\u26a0 ' + json.error;
                discoverStatus.style.color = '#dc2626';
                return;
            }

            var repos = json.repositories || [];
            if (repos.length === 0) {
                discoverStatus.textContent = 'No repositories found on this server.';
                discoverStatus.style.color = '#d97706';
                return;
            }

            if (repos.length === 1) {
                repoInput.value = repos[0].id;
                discoverStatus.textContent = '\u2713 Found: ' + repos[0].name;
                discoverStatus.style.color = '#16a34a';
                return;
            }

            // Multiple repos — build a small inline select
            var selectHtml = '<select id="repo-select" class="field-input" style="margin-top:6px;">';
            repos.forEach(function(r) {
                selectHtml += '<option value="' + r.id + '">' + r.name + ' (' + r.id + ')</option>';
            });
            selectHtml += '</select>';
            discoverStatus.innerHTML = '\u2713 ' + repos.length + ' repositories found. Select one: ' + selectHtml;
            discoverStatus.style.color = '#16a34a';

            document.getElementById('repo-select').addEventListener('change', function() {
                repoInput.value = this.value;
            });
            // Pre-fill with first
            repoInput.value = repos[0].id;

        } catch (err) {
            discoverStatus.textContent = '\u26a0 Discovery failed: ' + err.message;
            discoverStatus.style.color = '#dc2626';
        } finally {
            discoverBtn.disabled    = false;
            discoverBtn.textContent = '\uD83D\uDD0D Discover';
        }
    });
}());
</script>
}
