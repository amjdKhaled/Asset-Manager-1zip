@model LFPortal.Web.Controllers.SearchViewModel
@using LFPortal.Domain.Entities
@{
    ViewData["Title"] = "Search";

    string FmtDate(DateTimeOffset? d) =>
        d is null ? "—" : d.Value.LocalDateTime.ToString("MMM d, yyyy");

    string FmtAgo(DateTimeOffset? d)
    {
        if (d is null) return "—";
        var diff = DateTimeOffset.UtcNow - d.Value;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 30) return $"{(int)diff.TotalDays}d ago";
        return d.Value.LocalDateTime.ToString("MMM d, yyyy");
    }

    // Build a URL that changes only the page number, keeping all other params.
    string PageUrl(int p)
    {
        var q = new System.Collections.Specialized.NameValueCollection
        {
            ["mode"]  = Model.Mode.ToString(),
            ["page"]  = p.ToString()
        };
        if (!string.IsNullOrWhiteSpace(Model.Query))        q["query"]        = Model.Query;
        if (!string.IsNullOrWhiteSpace(Model.TemplateName)) q["templateName"] = Model.TemplateName;
        if (!string.IsNullOrWhiteSpace(Model.FieldName))    q["fieldName"]    = Model.FieldName;
        if (!string.IsNullOrWhiteSpace(Model.FieldValue))   q["fieldValue"]   = Model.FieldValue;
        var parts = new System.Collections.Generic.List<string>();
        foreach (string key in q) parts.Add($"{Uri.EscapeDataString(key)}={Uri.EscapeDataString(q[key] ?? "")}");
        return "/Search?" + string.Join("&", parts);
    }

    var results = Model.Results;
    var hasResults = results is { TotalCount: > 0 };
    var pageCount  = results?.TotalPages ?? 0;
}

@section Styles {
<style>
/* ── Search page — dark theme matching Archive ── */
body   { background: #0f172a !important; }
main   { max-width: 1300px !important; padding: 18px 22px !important; }
footer.site-footer { background: #0a1020 !important; }

:root {
    --s-bg:      #0f172a;
    --s-surface: #1e293b;
    --s-surf2:   #263349;
    --s-border:  #334155;
    --s-text:    #f1f5f9;
    --s-muted:   #94a3b8;
    --s-accent:  #3b82f6;
    --s-green:   #22c55e;
    --s-orange:  #f97316;
    --s-red:     #ef4444;
    --s-yellow:  #f59e0b;
    --s-teal:    #14b8a6;
}

/* Header */
.srch-header { display:flex; align-items:flex-start; justify-content:space-between;
               flex-wrap:wrap; gap:10px; margin-bottom:18px; }
.srch-title  { color:var(--s-text); font-size:1.2rem; font-weight:600; }
.srch-sub    { color:var(--s-muted); font-size:.78rem; margin-top:2px; }

/* Mode tabs */
.srch-tabs   { display:flex; gap:4px; margin-bottom:16px; flex-wrap:wrap; }
.srch-tab    { padding:7px 16px; border-radius:8px; font-size:.82rem; font-weight:600;
               cursor:pointer; border:1px solid var(--s-border); color:var(--s-muted);
               background:var(--s-surface); text-decoration:none; transition:all .15s; }
.srch-tab:hover   { border-color:var(--s-accent); color:var(--s-text); }
.srch-tab.active  { background:var(--s-accent); border-color:var(--s-accent);
                    color:#fff; }

/* Search form card */
.srch-card   { background:var(--s-surface); border:1px solid var(--s-border);
               border-radius:12px; padding:20px 22px; margin-bottom:18px; }
.srch-row    { display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; }
.srch-group  { display:flex; flex-direction:column; gap:5px; flex:1; min-width:200px; }
.srch-label  { font-size:.72rem; font-weight:700; color:var(--s-muted);
               text-transform:uppercase; letter-spacing:.06em; }
.srch-input  { background:var(--s-surf2); border:1px solid var(--s-border);
               border-radius:8px; padding:9px 13px; color:var(--s-text);
               font-size:.875rem; outline:none; width:100%; }
.srch-input::placeholder { color:var(--s-muted); }
.srch-input:focus { border-color:var(--s-accent);
                    box-shadow:0 0 0 2px rgba(59,130,246,.2); }
select.srch-input option { background:#1e293b; color:#f1f5f9; }
.srch-hint   { font-size:.68rem; color:var(--s-muted); margin-top:3px; }

/* Search button */
.srch-btn    { padding:9px 22px; border-radius:8px; font-size:.875rem; font-weight:600;
               background:var(--s-accent); color:#fff; border:none; cursor:pointer;
               white-space:nowrap; transition:background .15s; flex-shrink:0; }
.srch-btn:hover { background:#2563eb; }

/* Results card */
.srch-results-hdr { display:flex; align-items:center; justify-content:space-between;
                     gap:12px; margin-bottom:12px; flex-wrap:wrap; }
.srch-results-count { font-size:.82rem; color:var(--s-muted); }
.srch-results-count strong { color:var(--s-text); }

/* Table */
.srch-tbl    { width:100%; border-collapse:collapse; font-size:.8rem; }
.srch-tbl th { text-align:left; padding:9px 12px; font-weight:600; color:var(--s-muted);
               background:rgba(255,255,255,.04); border-bottom:1px solid var(--s-border);
               white-space:nowrap; }
.srch-tbl td { padding:9px 12px; color:var(--s-text); border-bottom:1px solid rgba(51,65,85,.45);
               vertical-align:top; }
.srch-tbl tr:last-child td { border-bottom:none; }
.srch-tbl tr:hover td { background:rgba(255,255,255,.025); }

/* Entry name cell */
.srch-name   { font-weight:500; display:flex; align-items:flex-start; gap:8px; }
.srch-name-text { word-break:break-word; line-height:1.4; }
.srch-path   { font-size:.7rem; color:var(--s-muted); font-family:monospace;
               word-break:break-all; margin-top:3px; line-height:1.3; }

/* Type badge */
.srch-badge  { display:inline-flex; align-items:center; padding:2px 7px; border-radius:4px;
               font-size:.65rem; font-weight:700; text-transform:uppercase;
               letter-spacing:.04em; white-space:nowrap; }
.srch-badge-document { background:rgba(59,130,246,.12);  color:#60a5fa; border:1px solid rgba(59,130,246,.2); }
.srch-badge-folder   { background:rgba(245,158,11,.12);  color:#fbbf24; border:1px solid rgba(245,158,11,.2); }
.srch-badge-shortcut { background:rgba(148,163,184,.1);  color:#94a3b8; border:1px solid rgba(148,163,184,.2); }
.srch-badge-other    { background:rgba(148,163,184,.1);  color:#94a3b8; border:1px solid rgba(148,163,184,.2); }

/* Template badge */
.srch-tmpl   { display:inline-flex; align-items:center; padding:2px 7px; border-radius:4px;
               font-size:.68rem; font-weight:600; background:rgba(139,92,246,.1);
               color:#a78bfa; border:1px solid rgba(139,92,246,.2); white-space:nowrap; }

/* Action links */
.srch-actions { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
.srch-action  { font-size:.72rem; font-weight:600; padding:3px 9px; border-radius:5px;
                text-decoration:none; border:1px solid transparent; white-space:nowrap;
                transition:all .12s; }
.srch-action-view { background:rgba(59,130,246,.12); color:#60a5fa;
                    border-color:rgba(59,130,246,.25); }
.srch-action-view:hover { background:rgba(59,130,246,.22); color:#93c5fd; }
.srch-action-dl   { background:rgba(34,197,94,.08); color:#4ade80;
                    border-color:rgba(34,197,94,.2); }
.srch-action-dl:hover { background:rgba(34,197,94,.16); color:#86efac; }
.srch-action-folder { background:rgba(245,158,11,.10); color:#fbbf24;
                       border-color:rgba(245,158,11,.22); }
.srch-action-folder:hover { background:rgba(245,158,11,.18); color:#fcd34d; }

/* Empty / info states */
.srch-state  { display:flex; flex-direction:column; align-items:center; justify-content:center;
               padding:52px 24px; color:var(--s-muted); gap:10px; text-align:center; }
.srch-state-icon { opacity:.3; }
.srch-state-text { font-size:.85rem; max-width:360px; line-height:1.5; }

/* Alert */
.srch-alert  { border-radius:10px; padding:12px 16px; font-size:.83rem;
               display:flex; align-items:flex-start; gap:10px; line-height:1.5; }
.srch-alert-err  { background:rgba(239,68,68,.08); border:1px solid rgba(239,68,68,.25); color:#fca5a5; }
.srch-alert-warn { background:rgba(245,158,11,.08); border:1px solid rgba(245,158,11,.22); color:#fcd34d; }
.srch-alert-info { background:rgba(59,130,246,.08); border:1px solid rgba(59,130,246,.22); color:#93c5fd; }

/* Pagination */
.srch-pager  { display:flex; align-items:center; justify-content:center; gap:6px;
               margin-top:18px; flex-wrap:wrap; }
.srch-page-btn { padding:6px 13px; border-radius:7px; font-size:.8rem; font-weight:600;
                  text-decoration:none; border:1px solid var(--s-border); color:var(--s-muted);
                  background:var(--s-surface); transition:all .12s; }
.srch-page-btn:hover   { border-color:var(--s-accent); color:var(--s-text); }
.srch-page-btn.current { background:var(--s-accent); border-color:var(--s-accent); color:#fff; }
.srch-page-btn.disabled { opacity:.35; pointer-events:none; }
.srch-page-info { font-size:.78rem; color:var(--s-muted); padding:0 6px; }
</style>
}

<div style="color:var(--s-text)">

    <!-- Page header -->
    <div class="srch-header">
        <div>
            <div class="srch-title">🔍 Repository Search</div>
            <div class="srch-sub">Search all entries in the connected Laserfiche repository</div>
        </div>
    </div>

    <!-- Mode tabs -->
    <div class="srch-tabs">
        <a class="srch-tab @(Model.Mode == SearchMode.Simple   ? "active" : "")"
           href="/Search?mode=Simple">Simple</a>
        <a class="srch-tab @(Model.Mode == SearchMode.Template ? "active" : "")"
           href="/Search?mode=Template">By Template</a>
        <a class="srch-tab @(Model.Mode == SearchMode.Field    ? "active" : "")"
           href="/Search?mode=Field">By Field</a>
        <a class="srch-tab @(Model.Mode == SearchMode.Advanced ? "active" : "")"
           href="/Search?mode=Advanced">Advanced</a>
    </div>

    <!-- Search form -->
    <div class="srch-card">
        <form method="get" action="/Search" autocomplete="off">
            <input type="hidden" name="mode" value="@Model.Mode" />

            @if (Model.Mode == SearchMode.Simple)
            {
                <div class="srch-row">
                    <div class="srch-group" style="flex:2">
                        <label class="srch-label" for="query">Keyword or phrase</label>
                        <input class="srch-input" type="text" id="query" name="query"
                               value="@Model.Query" placeholder="e.g. annual report, contract, invoice…"
                               autofocus />
                        <div class="srch-hint">Searches entry names and full-text content where full-text indexing is enabled.</div>
                    </div>
                    <button class="srch-btn" type="submit">Search</button>
                </div>
            }
            else if (Model.Mode == SearchMode.Advanced)
            {
                <div class="srch-row">
                    <div class="srch-group" style="flex:2">
                        <label class="srch-label" for="query">Laserfiche search expression</label>
                        <input class="srch-input" type="text" id="query" name="query"
                               value="@Model.Query"
                               placeholder="e.g. ({LF:Name}=&quot;Report*&quot;) &amp; ({LF:Template}=&quot;Finance&quot;)"
                               autofocus />
                        <div class="srch-hint">
                            Full Laserfiche expression syntax. Use <code style="color:var(--s-accent)">{LF:Name}</code>,
                            <code style="color:var(--s-accent)">{LF:Template}</code>,
                            <code style="color:var(--s-accent)">{LF:Basic}</code>,
                            or metadata field names in braces.
                        </div>
                    </div>
                    <button class="srch-btn" type="submit">Search</button>
                </div>
            }
            else if (Model.Mode == SearchMode.Template)
            {
                <div class="srch-row">
                    <div class="srch-group">
                        <label class="srch-label" for="templateName">Template</label>
                        @if (Model.AvailableTemplates.Count > 0)
                        {
                            <select class="srch-input" id="templateName" name="templateName" autofocus>
                                <option value="">— select a template —</option>
                                @foreach (var t in Model.AvailableTemplates)
                                {
                                    if (Model.TemplateName == t)
                                    { <option value="@t" selected>@t</option> }
                                    else
                                    { <option value="@t">@t</option> }
                                }
                            </select>
                        }
                        else
                        {
                            <input class="srch-input" type="text" id="templateName" name="templateName"
                                   value="@Model.TemplateName"
                                   placeholder="Template name (exact)" autofocus />
                        }
                        <div class="srch-hint">Returns all entries that have this metadata template applied.</div>
                    </div>
                    <button class="srch-btn" type="submit">Search</button>
                </div>
            }
            else if (Model.Mode == SearchMode.Field)
            {
                <div class="srch-row">
                    <div class="srch-group">
                        <label class="srch-label" for="fieldName">Field name</label>
                        @if (Model.AvailableFields.Count > 0)
                        {
                            <select class="srch-input" id="fieldName" name="fieldName">
                                <option value="">— select a field —</option>
                                @foreach (var f in Model.AvailableFields)
                                {
                                    if (Model.FieldName == f)
                                    { <option value="@f" selected>@f</option> }
                                    else
                                    { <option value="@f">@f</option> }
                                }
                            </select>
                        }
                        else
                        {
                            <input class="srch-input" type="text" id="fieldName" name="fieldName"
                                   value="@Model.FieldName" placeholder="Field name (exact)" autofocus />
                        }
                    </div>
                    <div class="srch-group">
                        <label class="srch-label" for="fieldValue">Value</label>
                        <input class="srch-input" type="text" id="fieldValue" name="fieldValue"
                               value="@Model.FieldValue" placeholder="Value to match (use * as wildcard)" />
                    </div>
                    <button class="srch-btn" type="submit">Search</button>
                </div>
            }
        </form>
    </div>

    <!-- ── Results area ─────────────────────────────────────────────────── -->

    @if (!Model.HasSearched)
    {
        <!-- Landing / prompt state -->
        <div class="srch-state">
            <div class="srch-state-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
            </div>
            <div class="srch-state-text">
                Enter a search term above to find documents and folders in the Laserfiche repository.
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <!-- Error state -->
        <div class="srch-alert @(Model.IsAuthError ? "srch-alert-warn" : Model.IsTimeout ? "srch-alert-info" : "srch-alert-err")">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <div>
                @Model.ErrorMessage
                @if (Model.IsAuthError)
                {
                    <span> — <a href="/Settings" style="color:inherit;font-weight:700">Open Settings</a></span>
                }
            </div>
        </div>
    }
    else if (Model.HasSearched && !hasResults)
    {
        <!-- No results state -->
        <div class="srch-state">
            <div class="srch-state-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    <line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
            </div>
            <div class="srch-state-text">
                No entries matched your search. Try a different keyword, template, or field value.
            </div>
        </div>
    }
    else if (hasResults && results is not null)
    {
        <!-- Results -->
        <div class="srch-card" style="padding:0;overflow:hidden">
            <div class="srch-results-hdr" style="padding:14px 18px 12px">
                <div class="srch-results-count">
                    <strong>@results.TotalCount</strong>
                    @(results.TotalCount == 1 ? "result" : "results")
                    @if (results.TotalPages > 1)
                    {
                        <span style="margin-left:6px">— page @results.PageNumber of @results.TotalPages</span>
                    }
                </div>
                <div style="font-size:.73rem;color:var(--s-muted)">
                    @{
                        string modeLabel;
                        if      (Model.Mode == SearchMode.Simple)   modeLabel = "Simple: \"" + Model.Query + "\"";
                        else if (Model.Mode == SearchMode.Advanced) modeLabel = "Advanced: \"" + Model.Query + "\"";
                        else if (Model.Mode == SearchMode.Template) modeLabel = "Template: \"" + Model.TemplateName + "\"";
                        else if (Model.Mode == SearchMode.Field)    modeLabel = "Field: \"" + Model.FieldName + "\" = \"" + Model.FieldValue + "\"";
                        else                                         modeLabel = "";
                    }
                    @modeLabel
                </div>
            </div>

            <table class="srch-tbl">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Template</th>
                        <th>Created By</th>
                        <th>Created</th>
                        <th>Modified</th>
                        <th>Entry ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in results.Items)
                    {
                        var isDoc    = r.EntryType == LFEntryType.Document;
                        var isFolder = r.EntryType == LFEntryType.Folder;

                        var typeBadge = r.EntryType switch
                        {
                            LFEntryType.Document => ("srch-badge-document", "Document"),
                            LFEntryType.Folder   => ("srch-badge-folder",   "Folder"),
                            LFEntryType.Shortcut => ("srch-badge-shortcut", "Shortcut"),
                            _                    => ("srch-badge-other",    r.EntryType.ToString())
                        };

                        // Derive parent folder path for the Open in Archive link.
                        // FullPath is e.g. \Dept\Year\FileName — we want the parent folder entryId
                        // which we do NOT have from search results. We navigate to Archive by entryId
                        // directly (Archive/Index?entryId=X navigates to that specific entry's parent
                        // when it is a document by redirecting; for folders entryId navigates into it).
                        <tr>
                            <td>
                                <div class="srch-name">
                                    @if (isDoc)
                                    {
                                        <svg width="14" height="15" viewBox="0 0 24 24" fill="#3b82f6" stroke="#2563eb" stroke-width="1" style="flex-shrink:0;margin-top:1px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="#1d4ed8" stroke-width="1.5"/></svg>
                                    }
                                    else if (isFolder)
                                    {
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="rgba(245,158,11,.25)" stroke="#f59e0b" stroke-width="1.5" style="flex-shrink:0;margin-top:1px"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" style="flex-shrink:0;margin-top:1px"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                                    }
                                    <div>
                                        <div class="srch-name-text">@r.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(r.FullPath))
                                        {
                                            <div class="srch-path">@r.FullPath</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><span class="srch-badge @typeBadge.Item1">@typeBadge.Item2</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.TemplateName))
                                {
                                    <span class="srch-tmpl">@r.TemplateName</span>
                                }
                                else
                                {
                                    <span style="color:var(--s-muted)">—</span>
                                }
                            </td>
                            <td style="color:var(--s-muted);font-size:.78rem">@(r.Creator ?? "—")</td>
                            <td style="color:var(--s-muted);font-size:.78rem;white-space:nowrap"
                                title="@FmtDate(r.CreationTime)">@FmtAgo(r.CreationTime)</td>
                            <td style="color:var(--s-muted);font-size:.78rem;white-space:nowrap"
                                title="@FmtDate(r.LastModifiedTime)">@FmtAgo(r.LastModifiedTime)</td>
                            <td style="font-family:monospace;font-size:.75rem;color:var(--s-accent)">@r.EntryId</td>
                            <td>
                                <div class="srch-actions">
                                    @if (isDoc)
                                    {
                                        <a class="srch-action srch-action-view"
                                           href="/Document/View/@r.EntryId"
                                           title="Open full document viewer">View</a>
                                        <a class="srch-action srch-action-dl"
                                           href="/Document/Download/@r.EntryId"
                                           title="Download the original electronic file">Download</a>
                                    }
                                    else if (isFolder)
                                    {
                                        <a class="srch-action srch-action-folder"
                                           href="/Archive?entryId=@r.EntryId"
                                           title="Open this folder in the Archive Browser">Open Folder</a>
                                    }
                                    else
                                    {
                                        <a class="srch-action srch-action-view"
                                           href="/Document/View/@r.EntryId"
                                           title="Open entry viewer">View</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (pageCount > 1)
            {
                <div class="srch-pager" style="padding-bottom:18px">
                    <a class="srch-page-btn @(!results.HasPreviousPage ? "disabled" : "")"
                       href="@PageUrl(results.PageNumber - 1)">← Prev</a>

                    @{
                        // Show at most 7 page buttons centred on current page
                        var start = Math.Max(1, results.PageNumber - 3);
                        var end   = Math.Min(pageCount, start + 6);
                        start = Math.Max(1, end - 6);
                    }

                    @if (start > 1)
                    {
                        <a class="srch-page-btn" href="@PageUrl(1)">1</a>
                        if (start > 2)
                        {
                            <span class="srch-page-info">…</span>
                        }
                    }

                    @for (var p = start; p <= end; p++)
                    {
                        <a class="srch-page-btn @(p == results.PageNumber ? "current" : "")"
                           href="@PageUrl(p)">@p</a>
                    }

                    @if (end < pageCount)
                    {
                        if (end < pageCount - 1)
                        {
                            <span class="srch-page-info">…</span>
                        }
                        <a class="srch-page-btn" href="@PageUrl(pageCount)">@pageCount</a>
                    }

                    <a class="srch-page-btn @(!results.HasNextPage ? "disabled" : "")"
                       href="@PageUrl(results.PageNumber + 1)">Next →</a>
                </div>
            }
        </div>
    }

</div>
