@model LFPortal.Web.Controllers.LaunchLoadingViewModel
@{
    Layout = null;
    ViewData["Title"] = "Opening Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Opening Dashboard...</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            color: #e8eefb;
            background: radial-gradient(circle at top, #1d3768 0%, #101d38 48%, #0b1428 100%);
        }
        .launch-card {
            width: min(440px, 100%);
            padding: 46px 38px;
            text-align: center;
            border: 1px solid rgba(148, 163, 184, .2);
            border-radius: 18px;
            background: rgba(20, 35, 66, .92);
            box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
        }
        .brand { font-size: 1.65rem; font-weight: 750; letter-spacing: .01em; }
        .brand span { color: #60a5fa; }
        .spinner {
            width: 48px;
            height: 48px;
            margin: 30px auto 24px;
            border: 4px solid rgba(96, 165, 250, .22);
            border-top-color: #60a5fa;
            border-radius: 50%;
            animation: spin .8s linear infinite;
        }
        h1 { margin: 0 0 10px; font-size: 1.35rem; }
        p { margin: 0; color: #b8c6df; line-height: 1.6; }
        .repository { margin-top: 20px; font-size: .82rem; color: #8fa5c9; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 1.8s; } }
    </style>
</head>
<body>
    <main class="launch-card" aria-live="polite">
        <div class="brand">Laserfiche <span>Dashboard</span></div>
        <div class="spinner" role="status" aria-label="Loading"></div>
        <h1>Opening Dashboard...</h1>
        <p>Signing you in with your existing Laserfiche session.</p>
        <div class="repository">Repository: @Model.RepositoryId</div>
        <noscript>
            <p><a href="@Model.RedirectUrl">Continue to Dashboard sign-in</a></p>
        </noscript>
    </main>
    <script>
        (() => {
            const redirectUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RedirectUrl));
            window.setTimeout(() => window.location.replace(redirectUrl), 300);
        })();
    </script>
</body>
</html>
