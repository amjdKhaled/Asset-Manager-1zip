<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LFPortal.Web\LFPortal.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-link the installer's pure host-selection logic so the TLS
         regression tests run against the REAL production code, not a copy.
         ApiHostSelector.cs is intentionally dependency-free (no WinForms/WiX). -->
    <Compile Include="..\..\installer\Dashboard.BA\ApiHostSelector.cs"
             Link="Installer\ApiHostSelector.cs" />
    <Compile Include="..\..\installer\Dashboard.SetupHelper\TlsTrustPlanner.cs"
             Link="Installer\TlsTrustPlanner.cs" />
  </ItemGroup>

</Project>
