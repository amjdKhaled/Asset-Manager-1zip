<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <!-- Must target .NET Framework 4.8: the Laserfiche Desktop Client SDK (SDK 10.4)
         ships net-4.0 DLLs that are not compatible with .NET 5+. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Dashboard.DesktopExtension</AssemblyName>
    <RootNamespace>LFPortal.DesktopExtension</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Platform target: x64, matching the GovSearch AI Laserfiche extension
         (laserfiche-extension/GovSearchAIAssistant.csproj) which is the only other
         Laserfiche toolbar extension on this machine that uses WebView2 and is
         confirmed working. The Laserfiche Desktop Client is a 32-bit (x86) process
         (see CustomButtonManager/CustomButtonManager.csproj), but our extension runs
         as a separate child process whose architecture is determined by its own PE
         header — not the parent's. x64 is required because:
           1. GovSearch confirms WebView2 works at x64 on this machine.
           2. AnyCPU without an explicit PlatformTarget leaves the WebView2 NuGet
              build targets without a concrete arch, causing the wrong-bitness
              WebView2Loader.dll to be loaded → ERROR_BAD_FORMAT (0x8007000B). -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Copy the Laserfiche SDK into this repository-relative folder on Windows:
         vendor\LaserficheSdk\bin\10.4\net-4.0\ -->
    <LaserficheSdkRoot>$(MSBuildThisFileDirectory)..\..\vendor\LaserficheSdk</LaserficheSdkRoot>
    <ClientAutomationHintPath>$(LaserficheSdkRoot)\bin\10.4\net-4.0\ClientAutomation.dll</ClientAutomationHintPath>

    <!-- Product metadata -->
    <Company>Dashboard</Company>
    <Product>Dashboard Desktop Extension</Product>
    <Description>Laserfiche Desktop Client toolbar button that opens the Dashboard portal in a standalone WebView2 popup.</Description>
    <Copyright>Copyright © 2026 Dashboard</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Build annotation: this project requires the Laserfiche SDK 10.4 DLLs to be
         present on the build machine. It is excluded from the main LFPortal.sln and
         must be built separately on a Windows machine with the Laserfiche Desktop
         Client installed. See docs/LFDesktopExtension.md for build instructions. -->
  </PropertyGroup>

  <!-- Laserfiche ClientAutomation SDK — required for toolbar button registration.
       This repository-relative path keeps the project portable. See
       docs/LFDesktopExtension.md for the Windows SDK copy step. -->
  <ItemGroup Condition="Exists('$(ClientAutomationHintPath)')">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="ClientAutomation">
      <HintPath>$(ClientAutomationHintPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Clean CI/build computers use a compile-only API surface. It is marked
       non-copy-local and is never distributed; installed Laserfiche supplies
       the real ClientAutomation.dll when registration runs. -->
  <ItemGroup Condition="!Exists('$(ClientAutomationHintPath)')">
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\..\build\ClientAutomation.ReferenceStub\ClientAutomation.ReferenceStub.csproj"
                      Private="false" />
  </ItemGroup>

  <Target Name="ReportClientAutomationReference" BeforeTargets="Build">
    <Message Importance="high"
             Condition="Exists('$(ClientAutomationHintPath)')"
             Text="Using Laserfiche ClientAutomation SDK: $(ClientAutomationHintPath)" />
    <Warning Condition="!Exists('$(ClientAutomationHintPath)')"
             Text="Laserfiche SDK not found; using the compile-only ClientAutomation reference stub. The stub will not be copied to release output." />
  </Target>

  <!-- NuGet packages -->
  <ItemGroup>
    <!-- System.Text.Json is not inbox on net48; use Newtonsoft.Json from NuGet. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- WebView2 WinForms control — hosts the Dashboard web application in a
         native popup window. Version 1.0.2420.47 is used here because it is the
         version confirmed working on this machine by the GovSearch AI extension
         (laserfiche-extension/GovSearchAIAssistant.csproj). Requires the Microsoft
         Edge WebView2 Runtime on the end-user machine (Evergreen or Fixed).
         At PlatformTarget=x64 MSBuild correctly promotes:
             runtimes\win-x64\native\WebView2Loader.dll
         to the output directory, avoiding the BadImageFormatException that occurs
         with AnyCPU (0x8007000B / ERROR_BAD_FORMAT). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2420.47" />
  </ItemGroup>

  <!-- Static content to copy to the output directory.
       Dashboard.ico is read at runtime by ToolbarRegistrar (icon registration)
       and DashboardWindow (window icon). The path used by ToolbarRegistrar is:
           <ExeDir>\Resources\Dashboard.ico
       so the file must be present in the Resources\ sub-folder of the output. -->
  <ItemGroup>
    <Content Include="Resources\Dashboard.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Exclude from the main LFPortal.sln build. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
